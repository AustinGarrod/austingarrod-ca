{
  "extends": "astro/tsconfigs/strict",
  "exclude": ["node_modules", "dist", "ds-bundle", ".ds-sync", ".design-sync", "public/reporting/vendor", "tmp", "output"],
  "compilerOptions": {
    "baseUrl": ".",
    "resolveJsonModule": true,
    "types": ["node"],
    "paths": {
      "@components/*": ["src/components/*"],
      "@data/*": ["src/data/*"],
      "@layouts/*": ["src/layouts/*"],
      "@styles/*": ["src/styles/*"]
    }
  }
}
