{
  "name": "austingarrod-ca",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --host 0.0.0.0",
    "predev": "node scripts/prepare-reporting.mjs",
    "precheck": "node scripts/prepare-reporting.mjs",
    "prebuild": "node scripts/prepare-reporting.mjs",
    "build": "npm run build:site && node scripts/companion.mjs build",
    "reporting:upload": "npm run reporting:upload:site && node scripts/companion.mjs reporting",
    "check": "astro check",
    "preview": "astro preview --host 0.0.0.0",
    "test": "npm run test:site && node scripts/companion.mjs test",
    "generate:assets": "python scripts/generate-assets.py",
    "write:deployment-manifest": "python scripts/write-deployment-manifest.py",
    "verify:dist": "node scripts/companion.mjs verify && python scripts/verify-build.py",
    "build:deploy": "npm run generate:assets && npm run build && npm run reporting:upload && npm run write:deployment-manifest && npm run verify:dist",
    "build:site": "astro check && astro build && sentry-cli sourcemaps inject dist/_astro && node scripts/generate-radius-map-service-worker.mjs",
    "test:site": "vitest run",
    "install:companion": "node scripts/companion.mjs install",
    "test:companion:e2e": "node scripts/companion.mjs e2e",
    "prepare:companion-migration": "node scripts/companion.mjs migration",
    "reporting:upload:site": "node scripts/upload-reporting.mjs",
    "prebuild:site": "node scripts/prepare-reporting.mjs",
    "refresh:pokedex": "node scripts/refresh-pokedex-catalog.mjs",
    "test:pokedex:api": "node scripts/test-pokedex-api.mjs",
    "test:pokedex:browser": "node scripts/test-pokedex-browser.mjs"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.9",
    "@lucide/astro": "^1.23.0",
    "@sentry/browser": "^10.76.2",
    "astro": "^7.0.7",
    "leaflet": "^1.9.4",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@sentry/cli": "^3.8.2",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.10.1",
    "fake-indexeddb": "^6.2.8",
    "vitest": "^4.1.10"
  }
}
