{
  "name": "idle-slayer-companion",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "packageManager": "yarn@4.13.0",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "preview": "vite preview",
    "test": "vitest run",
    "test:tools": "node scripts/test-tools.mjs",
    "test:e2e": "node scripts/prepare-site-migration.mjs && playwright test",
    "validate:catalog": "vitest run src/domain/catalog.test.ts src/domain/companion-catalog.test.ts",
    "notices:check": "node scripts/maintain-runtime-notices.mjs check",
    "notices:refresh": "node scripts/maintain-runtime-notices.mjs refresh",
    "check:release": "node scripts/check-release.mjs",
    "prepare:migration": "node scripts/prepare-site-migration.mjs"
  },
  "dependencies": {
    "@dagrejs/dagre": "3.1.1",
    "@fontsource/press-start-2p": "5.3.0",
    "@sentry/react": "11.9.0",
    "@xyflow/react": "12.12.0",
    "qrcode-generator": "patch:qrcode-generator@npm%3A2.0.4#~/.yarn/patches/qrcode-generator-npm-2.0.4-763b3d6a6b.patch",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@sentry/cli": "2.58.6",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "6.0.2",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}
