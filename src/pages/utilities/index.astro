---
import { UserRound } from "@lucide/astro";
import UtilityCard from "@components/UtilityCard.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import { profile, utilities } from "@data/profile";
import { createUtilitiesStructuredData, UTILITIES_ITEM_LIST_ID } from "@data/seo";

const utilitiesStructuredData = createUtilitiesStructuredData(utilities);
---

<BaseLayout
  active="utilities"
  title={`Utilities | ${profile.name}`}
  description="Focused browser utilities by Austin Garrod for practical tasks and game planning. Most work without an account; Radius Map needs one to save measurements."
  schemaType="CollectionPage"
  breadcrumbLabel="Utilities"
  mainEntityId={UTILITIES_ITEM_LIST_ID}
  structuredData={utilitiesStructuredData}
>
  <section class="page-hero page-hero-compact">
    <div class="container page-hero-inner">
      <p class="eyebrow">Practical tools</p>
      <h1>Utilities</h1>
      <p>
        Browser tools for practical tasks and game planning, built for desktop and mobile. Pokémon Binder Tracker and Idle Slayer Companion work without an account; Radius Map needs one to save measurements.
      </p>
      <div class="button-row">
        <a class="button secondary rr-block" data-analytics-private href="/account/">
          <UserRound size={18} aria-hidden="true" />
          Account and sync
        </a>
      </div>
    </div>
  </section>

  <section class="container content-section utilities-list-section">
    <div class="utilities-grid">
      {utilities.map((utility) => <UtilityCard utility={utility} />)}
    </div>
  </section>
</BaseLayout>
