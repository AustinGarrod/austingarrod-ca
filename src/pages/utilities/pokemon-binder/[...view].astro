---
import { ArrowDownUp, ArrowLeft, BookOpen, ChevronRight, Download, Ellipsis, FileUp, Plus, Printer, Settings2, Cloud, Camera, Check, ListChecks, Search, Share2, ShoppingBag } from "@lucide/astro";
import BinderChecklist from "@components/BinderChecklist.astro";
import BinderPages from "@components/BinderPages.astro";
import BinderToolbar from "@components/BinderToolbar.astro";
import MasterSetBinders from "@components/MasterSetBinders.astro";
import BinderTransfers from "@components/BinderTransfers.astro";
import BinderCatalogSearch from "@components/BinderCatalogSearch.astro";
import BinderPricing from "@components/BinderPricing.astro";
import BinderBuyCards from "@components/BinderBuyCards.astro";
import BinderViewHeading from "@components/BinderViewHeading.astro";
import BinderShare from "@components/BinderShare.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import UtilityHeader from "@components/UtilityHeader.astro";
import UtilityUpdateNotice from "@components/UtilityUpdateNotice.astro";
import { utilities } from "@data/profile";
import { createUtilityApplicationSchema } from "@data/seo";
import { binderViewPaths, buyCardsSlug } from "../../../utilities/pokedex-binder/lib/view-routes";
import "../../../styles/pokedex-binder.css";
import "../../../styles/pokedex-binder-dialogs.css";

export function getStaticPaths() {
  return [{ params: { view: undefined } }, { params: { view: buyCardsSlug } }];
}

const utility = utilities.find((item) => item.slug === "pokemon-binder");
if (!utility) throw new Error("Pokémon Binder Tracker utility metadata is missing.");
const buying = Astro.params.view === buyCardsSlug;
const bindersTitle = utility.title + " | Austin Garrod";
---

<BaseLayout shell="utility" title={buying ? "Buy cards | " + bindersTitle : bindersTitle} description={utility.summary} breadcrumbLabel={buying ? "Buy cards" : utility.title} structuredData={createUtilityApplicationSchema(utility)} bodyClass="pokedex-page">
  <link slot="head" rel="preconnect" href="https://assets.tcgdex.net" />
  <UtilityHeader toolName={utility.title} />
  <UtilityUpdateNotice releasePath="/utilities/pokemon-binder/utility-release.json" />

  <div class="dex-app rr-block" id="dex-app" data-binders-title={bindersTitle} data-analytics-private aria-busy="true">
    <nav class="dex-binder-nav" aria-label="Pokémon Binder">
      <a id="binders-open" href={binderViewPaths.binders} data-binder-view="binders" aria-current={buying ? undefined : "page"}><BookOpen size={16} aria-hidden="true" /> Binders</a>
      <a id="buy-cards-open" href={binderViewPaths["buy-cards"]} data-binder-view="buy-cards" aria-current={buying ? "page" : undefined}><ShoppingBag size={16} aria-hidden="true" /> Buy cards</a>
    </nav>
    <div id="binders-workspace" hidden={buying}>
    <header id="binder-bar" class="dex-appbar">
      <button id="binder-back" type="button" class="dex-back" aria-label="All binders" hidden><ArrowLeft size={18} aria-hidden="true" /><span>All binders</span></button>
      <div class="dex-appbar-title">
        <p id="master-set-label" class="dex-eyebrow" hidden></p>
        {!buying && <BinderViewHeading view="binders" title={utility.title} />}
        <p id="dex-status" class="dex-status" role="status" aria-live="polite">Loading your binder…</p>
        <p id="master-message" role="status" class="dex-status-note"></p>
      </div>
      <div class="dex-appbar-actions">
        <button id="catalog-search-open" type="button" aria-haspopup="dialog" aria-label="Search cards" disabled><Search size={17} aria-hidden="true" /><span>Search cards</span></button>
        <button id="binder-share-open" type="button" aria-haspopup="dialog" hidden><Share2 size={17} aria-hidden="true" /><span>Share binder</span></button>
        <details id="binder-menu" class="dex-menu">
          <summary aria-label="Binder actions"><Ellipsis size={18} aria-hidden="true" /><span>Menu</span></summary>
          <div class="dex-menu-list">
            <button id="scan-open" type="button"><Camera size={16} aria-hidden="true" /> Scan cards</button>
            <button id="master-scan" type="button" hidden><Camera size={16} aria-hidden="true" /> Scan cards</button>
            <button id="master-select-set" type="button" aria-haspopup="dialog" hidden><ListChecks size={16} aria-hidden="true" /> Select all in set</button>
            <button id="layout-open" type="button" aria-haspopup="dialog" hidden><Settings2 size={16} aria-hidden="true" /> Binder settings</button>
            <button id="master-settings" type="button" aria-haspopup="dialog" hidden><Settings2 size={16} aria-hidden="true" /> Binder settings</button>
            <button id="master-add-extra" type="button" aria-haspopup="dialog" hidden><Plus size={16} aria-hidden="true" /> Add an extra card</button>
            <button id="binder-share-menu" type="button" aria-haspopup="dialog" hidden><Share2 size={16} aria-hidden="true" /> Share binder</button>
            <button id="transfer-open" type="button" aria-haspopup="dialog"><ArrowDownUp size={16} aria-hidden="true" /> Import and export</button>
            <button id="sync-open" type="button" aria-haspopup="dialog"><Cloud size={16} aria-hidden="true" /> Sync and backup</button>
          </div>
        </details>
      </div>
    </header>

    <div id="dex-warning" class="dex-notice" role="alert" hidden></div>
    <div id="dex-conflict" class="dex-notice" role="alert" hidden><p>Your binder layout changed on another device. Choose which layout to keep; your Pokémon marks will be merged.</p><button id="conflict-local">Keep this layout</button><button id="conflict-remote">Use synced layout</button></div>

    <p id="transfer-message" role="status" class="dex-help"></p>
    <MasterSetBinders />
    <div id="national-workspace" hidden>
    <section class="dex-progress" aria-label="Collection progress">
      <p id="progress-line" class="dex-progress-line"></p>
      <div><span class="dex-label">Collected</span><strong id="owned-count">—</strong></div>
      <div><span class="dex-label">Ordered</span><strong id="ordered-count">—</strong></div>
      <div><span class="dex-label">Still to find</span><strong id="missing-count">—</strong></div>
      <div class="dex-completion"><span class="dex-label" id="completion-label">Your National Pokédex</span><progress id="completion-bar" value="0" max="100" aria-labelledby="completion-label"></progress><span id="completion-detail">All species · Any card counts</span></div>
    </section>

    <BinderToolbar>
      <label class="dex-field-inline" for="dex-generation"><span>Generation</span><select id="dex-generation"><option value="all">All generations</option>{Array.from({length:9},(_,i)=><option value={i+1}>{i+1}</option>)}</select></label>
    </BinderToolbar>
    <section id="dex-results" class="dex-search-results" aria-label="Search results" hidden><p id="results-count" class="dex-label" role="status"></p><ol id="results-list" class="dex-result-list"></ol></section>

    <BinderPages />

    <BinderChecklist>
      <Fragment slot="filters">
        <label for="checklist-set">Filter by set<input id="checklist-set" type="search" list="checklist-sets" placeholder="All sets · Search set name or code" autocomplete="off" aria-describedby="checklist-filter-help" /></label>
        <datalist id="checklist-sets"></datalist>
        <button id="checklist-clear-set" class="dex-quiet">Clear set filter</button>
      </Fragment>
      <Fragment slot="help">
        <p id="checklist-filter-help" class="dex-help">Sets show available English printings. Collected status counts any card.</p>
        <p id="checklist-number-status" class="dex-help" role="status" hidden></p>
        <button id="checklist-number-retry" type="button" hidden>Retry card numbers</button>
      </Fragment>
    </BinderChecklist>

    </div>
    </div>
    <BinderBuyCards active={buying}>
      <Fragment slot="heading">
        {buying && <BinderViewHeading view="buy-cards" title={utility.title} />}
      </Fragment>
    </BinderBuyCards>
    <footer class="dex-footer"><p id="catalog-note">English physical cards · National Pokédex order</p><p>An unofficial fan tool. Pokémon and card artwork belong to their respective owners. Species data and sprites: <a href="https://pokeapi.co/" target="_blank" rel="noopener noreferrer" data-umami-event="outbound-link-click" data-umami-event-destination="pokeapi">PokéAPI</a>. Card data: <a href="https://tcgdex.net/" target="_blank" rel="noopener noreferrer" data-umami-event="outbound-link-click" data-umami-event-destination="tcgdex">TCGdex</a>. <a href="/utilities/pokedex-binder/licenses/ATTRIBUTION.txt" data-umami-event="utility-navigation" data-umami-event-destination="catalog-licenses">Data and artwork notices</a>.</p></footer>
  </div>
  <noscript><p class="container">Pokémon Binder Tracker needs JavaScript to display your collection and save progress.</p></noscript>
  <BinderTransfers />
  <BinderCatalogSearch />
  <BinderPricing />
  <BinderShare />

  <dialog id="printing-artwork-dialog" class="dex-dialog dex-collection-dialog rr-block" data-analytics-private aria-labelledby="printing-artwork-title">
    <header class="dex-dialog-header"><h2 id="printing-artwork-title">Card artwork</h2><button type="button" data-close-dialog aria-label="Close artwork preview" autofocus>×</button></header>
    <div class="dex-artwork-frame"></div>
    <footer class="dex-artwork-actions">
      <a>Open original</a>
      <p role="status"></p>
    </footer>
  </dialog>

  <dialog id="layout-dialog" class="dex-dialog dex-collection-dialog rr-block" data-analytics-private aria-labelledby="layout-title">
    <form id="layout-form">
      <header class="dex-dialog-header"><h2 id="layout-title">Binder settings</h2><button type="button" data-close-dialog aria-label="Close binder settings">×</button></header>
      <p class="dex-dialog-intro">Each page is one usable side. Pokémon fill from left to right, then top to bottom.</p>
      <div class="dex-form-grid">
        <label>Columns<input name="columns" type="number" min="1" max="6" required /></label>
        <label>Rows<input name="rows" type="number" min="1" max="6" required /></label>
      </div>
      <label>Page sides<select name="useBackSides"><option value="true">Use both sides of each sheet</option><option value="false">Use front sides only</option></select></label>
      <label>Reserved starting pockets<input name="leadingBlankPockets" type="number" min="0" max="1000" required /><small>Leave room before Bulbasaur for title cards or blank pages.</small></label>
      <p class="dex-help">Changing the layout keeps all of your collected Pokémon.</p>
      <p id="layout-error" class="dex-error" role="alert"></p>
      <div class="dex-dialog-actions"><button type="button" data-close-dialog>Cancel</button><button class="dex-primary" type="submit">Apply layout</button></div>
      <section class="dex-dialog-danger" aria-label="Hide National Pokédex">
        <button id="national-hide" type="button" class="dex-danger">Hide National Pokédex</button>
        <p class="dex-help">Your collected Pokémon and layout are kept. You can add it back with your progress.</p>
      </section>
    </form>
  </dialog>

  <dialog id="sync-dialog" class="dex-dialog dex-collection-dialog rr-block" data-analytics-private aria-labelledby="sync-title">
    <header class="dex-dialog-header"><h2 id="sync-title">Sync &amp; backup</h2><button type="button" data-close-dialog aria-label="Close sync and backup">×</button></header>
    <p id="sync-message" class="dex-notice" role="status"></p>
    <section id="binder-account-panel" hidden>
      <h3>Account sync</h3><p id="binder-account-status" class="dex-help"></p>
      <a id="binder-account-link" href="/account/?returnTo=%2Futilities%2Fpokedex-binder%2F">Sign in with email or Google</a>
      <div class="dex-actions"><button id="binder-account-review" hidden>Review & connect account</button><button id="binder-account-resume" hidden>Resume saved migration</button><button id="binder-account-sync" hidden>Sync account now</button><button id="binder-account-recheck" hidden>Retry saving & account connection</button><button id="binder-recovery-download" hidden>Download migration backups</button></div>
      <p class="dex-help">Connecting keeps recovery copies of your device and account data.</p>
    </section>
    <section class="dex-backups">
      <h3>Collection backup</h3>
      <button id="resume-restore" hidden>Finish interrupted backup restore</button>
      <button id="previous-restore" hidden>Download collection from before restore</button>
      <p class="dex-help">Download your collection and binder layouts before clearing browser data.</p>
      <div class="dex-backup-actions"><button id="export-json"><Download size={16} aria-hidden="true" /> Download JSON backup</button><label class="dex-file-label" for="import-json">Restore JSON backup<input id="import-json" type="file" accept=".json,application/json" /></label></div>
    </section>
    <p id="sync-error" class="dex-error" role="alert"></p>
  </dialog>
  <dialog id="transfer-dialog" class="dex-dialog dex-collection-dialog rr-block" data-analytics-private aria-labelledby="transfer-title">
    <header class="dex-dialog-header"><h2 id="transfer-title">Import and export</h2><button type="button" data-close-dialog aria-label="Close import and export">×</button></header>
    <section class="dex-transfer-choice" aria-labelledby="transfer-import-title">
      <div><h3 id="transfer-import-title">Import cards</h3><p class="dex-help">Bring over a collection from Collectr, TCG Collector, TCGplayer or another tracker.</p></div>
      <div class="dex-actions">
        <button id="import-collectr" type="button" aria-haspopup="dialog"><FileUp size={16} aria-hidden="true" /> Import from Collectr</button>
        <button id="import-cards" type="button" aria-haspopup="dialog">Import a CSV</button>
      </div>
    </section>
    <section class="dex-transfer-choice" aria-labelledby="transfer-export-title">
      <div><h3 id="transfer-export-title">Export cards</h3><p class="dex-help">Owned, missing or ordered cards as a CSV for another tracker.</p></div>
      <button id="export-cards" type="button" aria-haspopup="dialog" hidden><Download size={16} aria-hidden="true" /> Export cards</button>
    </section>
    <section id="missing-list-controls" class="dex-transfer-choice" aria-labelledby="transfer-list-title" hidden>
      <div><h3 id="transfer-list-title">Missing or ordered list</h3><p class="dex-help">With each card’s page and pocket, to download or print.</p></div>
      <div class="dex-form-grid">
        <label>Card list<select id="position-list"><option value="missing">Missing cards</option><option value="ordered">Ordered cards</option></select></label>
        <label>Binders<select id="export-scope"><option value="current">This binder</option><option value="all">All binders</option></select></label>
      </div>
      <div class="dex-actions"><button id="export-csv" type="button"><Download size={16} aria-hidden="true" /> Export missing CSV</button><button id="print-missing" type="button"><Printer size={16} aria-hidden="true" /> Print missing list</button></div>
      <p id="export-message" role="status" class="dex-help"></p>
    </section>
    <section class="dex-transfer-choice" aria-labelledby="transfer-backup-title">
      <div><h3 id="transfer-backup-title">JSON backup</h3><p class="dex-help">Everything in this browser, to restore later or on another device.</p></div>
      <button id="transfer-backup" type="button" aria-haspopup="dialog"><Cloud size={16} aria-hidden="true" /> Back up or restore</button>
    </section>
  </dialog>
  <dialog id="binder-migration-dialog" class="dex-dialog dex-collection-dialog rr-block" data-analytics-private aria-labelledby="binder-migration-title">
    <form id="binder-migration-form"><header class="dex-dialog-header"><h2 id="binder-migration-title">Review your binder copies</h2><button type="button" data-close-dialog aria-label="Close migration review">×</button></header>
      <div id="binder-migration-summary" role="status"></div>
      <p>Every original copy is kept for recovery. Combining keeps a Pokémon collected if any copy has it marked.</p>
      <label>Collection<select id="binder-migration-collection"><option value="combine">Combine all collected Pokémon</option><option value="device">Use this device's collection</option><option value="account">Use the account collection</option></select></label>
      <label>Binder layout<select id="binder-migration-layout" required><option value="">Choose a layout</option><option value="device">This device</option><option value="account">Account binder</option></select></label>
      <p id="binder-migration-error" class="dex-error" role="alert"></p>
      <div class="dex-dialog-actions"><button type="button" data-close-dialog>Keep using this device</button><button type="submit" class="dex-primary">Preserve copies & connect</button></div>
    </form>
  </dialog>
  <dialog id="confirm-dialog" class="dex-dialog rr-block" data-analytics-private aria-labelledby="confirm-title"><h2 id="confirm-title">Replace this binder?</h2><p id="confirm-text"></p><button id="confirm-backup">Download current backup</button><div class="dex-dialog-actions"><button id="confirm-cancel">Cancel</button><button id="confirm-accept" class="dex-primary">Continue</button></div></dialog>
  <dialog id="scan-dialog" class="dex-scan-dialog rr-block" data-phase="loading" data-analytics-private aria-labelledby="scan-title">
    <header class="dex-scan-heading"><h2 id="scan-title"><Camera size={21} aria-hidden="true" /> <span id="scan-title-label">Scan cards</span></h2><form method="dialog"><button id="scan-close" class="dex-scan-secondary" aria-label="Close scanner">Close</button></form></header>
    <p id="scan-status" class="dex-scan-status" role="status" aria-live="polite">Loading your binder…</p>
    <button id="scan-reload" type="button">Reload binder</button>
    <p class="dex-scan-privacy">Recognition stays on this device. Photos aren’t saved or uploaded.</p>
    <p id="scan-notice" class="dex-scan-notice" role="alert"></p>
    <div id="scan-camera" class="dex-scan-camera"><video id="scan-video" autoplay muted playsinline aria-label="Live card camera"></video><div id="scan-guide" class="dex-scan-guide" aria-hidden="true"><span>Card name at the top</span></div></div>
    <div id="scan-camera-actions" class="dex-scan-actions">
      <button id="scan-capture" class="dex-primary">Capture now</button>
      <button id="scan-flash" aria-pressed="false" hidden>Flash off</button>
      <button id="scan-manual" class="dex-scan-secondary">Search manually</button>
      <button id="scan-rescan" class="dex-scan-secondary">Rescan same card</button>
      <p id="scan-flash-notice" role="status"></p>
    </div>
    <div id="set-photo-controls"><label id="set-photo-label" class="dex-file-label" hidden>Use a photo<input id="master-photo" type="file" accept="image/*" /></label></div>
    <section id="set-scan-result" class="dex-scan-result" aria-labelledby="set-scan-name" hidden>
      <div class="dex-scan-result-body"><h3 id="set-scan-name"></h3>
        <div id="set-scan-finishes" class="dex-scan-candidates"></div>
        <div class="dex-set-scan-alternatives"><button id="set-scan-correct" class="dex-scan-correct">Change card</button><span id="set-result-photo"></span></div>
        <div id="set-scan-search-panel"><label for="master-scan-search">Search by name or collector number</label><input id="master-scan-search" type="search" />
          <div id="set-scan-choices" class="dex-scan-search-results"></div></div></div>
      <footer class="dex-scan-result-actions"><button id="set-scan-next">Scan next <ChevronRight size={17} aria-hidden="true" /></button></footer>
    </section>
    <section id="scan-result" class="dex-scan-result" aria-label="Scanned card result" hidden>
      <div id="scan-result-hero" class="dex-scan-result-hero"><canvas id="scan-preview" class="dex-scan-preview" role="img" aria-label="Captured card preview" hidden></canvas>
        <div id="scan-result-details" hidden><div class="dex-scan-species"><img id="scan-pokemon-sprite" width="64" height="64" alt="" /><div><span id="scan-dex-number" class="dex-label"></span><span id="scan-likely" hidden> · Likely match</span><h3 id="scan-pokemon-name"></h3><strong id="scan-owned-status"></strong></div></div></div>
      </div>
      <div class="dex-scan-result-body"><p id="scan-choice-help"></p><div id="scan-candidates" class="dex-scan-candidates" aria-label="Choose Pokémon"></div>
        <section id="scan-placement" class="dex-scan-placement" aria-label="Binder position" hidden><div class="dex-scan-placement-heading"><h3>Binder position</h3><span id="scan-sheet"></span></div><div id="scan-location" class="dex-scan-location" role="group"><div><span>Page</span><strong id="scan-location-page"></strong></div><div><span>Row</span><strong id="scan-location-row"></strong></div><div><span>Column</span><strong id="scan-location-column"></strong></div></div></section>
        <button id="scan-correct" class="dex-scan-correct">Change Pokémon</button>
        <div id="scan-search-panel" hidden><label for="scan-search">Search Pokémon name or Pokédex number</label><input id="scan-search" type="search" autocomplete="off" placeholder="Name or #0001" /><div id="scan-search-results" class="dex-scan-search-results"></div></div>
      </div>
      <footer class="dex-scan-result-actions"><button id="scan-mark" class="dex-primary" hidden><Check size={17} aria-hidden="true" /> Mark collected</button><button id="scan-next">Scan next <ChevronRight size={17} aria-hidden="true" /></button></footer>
    </section>
    <section id="scan-recovery" class="dex-scan-recovery" hidden><div class="dex-scan-actions"><button id="scan-resume" class="dex-primary">Resume camera</button><button id="scan-recovery-search">Search manually</button></div></section>
  </dialog>
  <section id="print-content" class="dex-print-only rr-block" data-analytics-private aria-label="Printable card list"></section>
  <script is:inline>
    // Accept the first tap even while the application module, catalog or account is loading.
    (() => {
      const dialog = document.getElementById("scan-dialog");
      const button = document.getElementById("scan-open");
      button.addEventListener("click", () => {
        if (!dialog.open && ["loading", "load-error"].includes(dialog.dataset.phase)) dialog.showModal();
        button.closest("details")?.removeAttribute("open");
      });
      document.getElementById("scan-reload").addEventListener("click", () => location.reload());
    })();
  </script>
  <script>import "../../../utilities/pokedex-binder/scripts/app";</script>
</BaseLayout>
