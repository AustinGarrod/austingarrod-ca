---
import "leaflet/dist/leaflet.css";
import "../../styles/radius-map.css";
import BaseLayout from "@layouts/BaseLayout.astro";
import UtilityHeader from "@components/UtilityHeader.astro";
import UtilityUpdateNotice from "@components/UtilityUpdateNotice.astro";
import { utilities } from "@data/profile";
import { createUtilityApplicationSchema } from "@data/seo";

const utility = utilities.find((item) => item.slug === "radius-map");
if (!utility) throw new Error("Radius Map utility metadata is missing.");

const title = "Radius Map — Draw a radius anywhere";
const description = "Draw, save, and compare radius or diameter measurements, then calculate a best-fit point from visible circles.";
const signInHref = "/account/?returnTo=%2Futilities%2Fradius-map%2F";
---

<BaseLayout
  shell="utility"
  title={title}
  description={description}
  breadcrumbLabel="Radius Map"
  structuredData={createUtilityApplicationSchema(utility)}
  manifestPath="/utilities/radius-map/manifest.webmanifest"
  themeColor="#f8f9ff"
  ogImagePath="/utilities/radius-map/og.png"
  ogImageAlt="Radius Map — Draw a radius anywhere"
  ogImageWidth={1731}
  ogImageHeight={909}
  bodyClass="radius-map-page"
  skipTarget="radius-panel"
>
  <Fragment slot="head">
    <meta name="application-name" content="Radius Map" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="Radius Map" />
    <link rel="icon" type="image/png" sizes="192x192" href="/utilities/radius-map/icons/icon-192.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/utilities/radius-map/icons/apple-touch-icon.png" />
  </Fragment>

  <div class="app-shell">
    <UtilityHeader toolName="Radius Map" variant="overlay">
      <a id="radius-library-location" href={signInHref}>Sign in</a>
    </UtilityHeader>
    <UtilityUpdateNotice releasePath="/utilities/radius-map/utility-release.json" overlay />

    <section id="radius-panel" class="control-panel" aria-labelledby="app-title" tabindex="-1">
      <header class="panel-header">
        <div class="panel-title">
          <h1 id="app-title">Radius Map</h1>
          <p id="panel-intro" class="uk-hint">Drawing is free. Saving needs a free account.</p>
        </div>
        <button
          id="panel-toggle"
          class="uk-button uk-button-quiet panel-toggle"
          type="button"
          aria-expanded="true"
          aria-controls="panel-content"
        >
          <span class="panel-toggle-label">Collapse</span>
          <span class="panel-toggle-icon" aria-hidden="true"></span>
        </button>
      </header>

      <div class="workspace-tabs" role="tablist" aria-label="Radius Map workspace">
        <button id="create-tab" class="workspace-tab" type="button" role="tab" aria-selected="true" aria-controls="create-panel">Draw</button>
        <button id="saved-tab" class="workspace-tab" type="button" role="tab" aria-selected="false" aria-controls="saved-panel" tabindex="-1">
          Saved <span id="saved-count" class="tab-count">0</span>
        </button>
        <button id="bestfit-tab" class="workspace-tab" type="button" role="tab" aria-selected="false" aria-controls="bestfit-panel" tabindex="-1">Best fit</button>
      </div>

      <div class="status-slot">
        <p id="app-status" class="uk-status app-status rr-block" data-analytics-private role="status" aria-live="polite">
          Search, use your location or tap the map to choose a centre.
        </p>
        <button id="status-undo" class="uk-button status-undo" type="button" hidden>Undo</button>
      </div>

      <aside id="radius-account-reminder" hidden></aside>
      <div id="panel-content" class="panel-content">
        <aside id="install-app-card" class="install-app-card" aria-label="Install Radius Map" hidden>
          <img src="/utilities/radius-map/icons/icon-192.png" width="40" height="40" alt="" />
          <div>
            <strong>Install Radius Map</strong>
            <span>Keep it one tap away on this device.</span>
          </div>
          <button id="install-app-button" class="uk-button" type="button" data-umami-event="radius-map-install">Install</button>
        </aside>

        <div id="create-panel" class="tab-panel" role="tabpanel" aria-labelledby="create-tab">
          <div id="edit-banner" class="edit-banner rr-block" data-analytics-private hidden>
            <p>Editing <strong id="edit-banner-name"></strong></p>
            <button id="cancel-edit-button" class="uk-button uk-button-quiet" type="button">Cancel</button>
          </div>

          <section class="rm-step location-step" aria-labelledby="location-heading">
            <h2 id="location-heading" class="uk-step">01 / Centre</h2>

            <div id="location-picker" class="location-picker">
              <form id="location-form" class="uk-field" novalidate>
                <label for="location-search" class="uk-label">Place or coordinates</label>
                <div class="search-row">
                  <div class="search-field">
                    <input
                      id="location-search"
                      class="uk-input rr-block"
                      data-analytics-private
                      name="location"
                      type="search"
                      placeholder="City or 43.65, -79.38"
                      autocomplete="off"
                      spellcheck="false"
                      aria-describedby="location-error"
                    />
                    <button id="search-button" class="uk-button uk-button-primary search-button" type="submit" data-umami-event="radius-map-search">Find</button>
                  </div>
                  <button
                    id="locate-button"
                    class="uk-button locate-button"
                    type="button"
                    title="Use my location"
                    data-umami-event="radius-map-geolocation"
                  >
                    <span class="locate-symbol" aria-hidden="true"></span>
                    <span class="sr-only">Use my location</span>
                  </button>
                </div>
              </form>
              <p id="location-error" class="uk-error" hidden></p>
              <ul id="search-results" class="search-results rr-block" data-analytics-private aria-label="Location search results" hidden></ul>
            </div>

            <div id="location-chosen" class="location-chosen rr-block" data-analytics-private hidden>
              <span class="chosen-mark" aria-hidden="true"></span>
              <p id="location-chosen-label">Selected centre</p>
              <div class="chosen-actions">
                <button id="location-change" class="uk-button uk-button-quiet" type="button">Change</button>
                <button id="location-clear" class="uk-button uk-button-quiet" type="button">Clear</button>
              </div>
            </div>
          </section>

          <section class="rm-step distance-step" aria-labelledby="measurement-heading">
            <h2 id="measurement-heading" class="uk-step">02 / Distance</h2>
            <div class="distance-fields">
              <div class="uk-field">
                <label id="measurement-label" class="uk-label" for="measurement-value">Distance</label>
                <div class="value-with-unit">
                  <input
                    id="measurement-value"
                    class="uk-input rr-block"
                    data-analytics-private
                    type="number"
                    value="10"
                    min="0"
                    step="any"
                    inputmode="decimal"
                    aria-describedby="measurement-error"
                  />
                  <fieldset class="uk-switch unit-switch">
                    <legend class="sr-only">Unit</legend>
                    <input id="unit-km" type="radio" name="distance-unit" value="km" checked />
                    <label for="unit-km">km</label>
                    <input id="unit-mi" type="radio" name="distance-unit" value="mi" />
                    <label for="unit-mi">mi</label>
                  </fieldset>
                </div>
              </div>
              <div class="uk-field kind-field">
                <span class="uk-label" aria-hidden="true">Measure</span>
                <fieldset class="uk-switch kind-switch">
                  <legend class="sr-only">Measure the distance as</legend>
                  <input id="kind-radius" type="radio" name="measurement-kind" value="radius" checked />
                  <label for="kind-radius">Radius</label>
                  <input id="kind-diameter" type="radio" name="measurement-kind" value="diameter" />
                  <label for="kind-diameter">Diameter</label>
                </fieldset>
              </div>
            </div>
            <p id="measurement-error" class="uk-error" hidden></p>
          </section>

          <div class="measurement-summary rr-block" data-analytics-private>
            <div class="summary-copy">
              <p id="summary-value">10 km radius</p>
              <p id="summary-detail">6.21 mi · 20 km diameter · 314.16 km² area</p>
              <p id="summary-centre">Choose a centre to draw the circle</p>
            </div>
            <button id="copy-summary-button" class="uk-button uk-button-quiet" type="button" disabled>Copy</button>
            <button id="peek-save-button" class="uk-button uk-button-primary peek-save" type="button" disabled>Save</button>
          </div>

          <div class="save-actions">
            <button
              id="save-measurement-button"
              class="uk-button uk-button-primary"
              type="button"
              disabled
              data-umami-event="radius-map-save"
            >Save measurement</button>
          </div>
        </div>

        <div id="saved-panel" class="tab-panel" role="tabpanel" aria-labelledby="saved-tab" hidden>
          <section class="saved-section" aria-labelledby="saved-heading">
            <h2 id="saved-heading" class="sr-only">Saved measurements</h2>

            <div id="library-signed-out" class="library-message" hidden>
              <strong>Saved measurements live in your account.</strong>
              <span>Sign in to keep circles and see them on any device. Drawing stays free.</span>
              <a id="radius-sign-in" class="uk-button uk-button-primary" href={signInHref} hidden>Sign in</a>
            </div>

            <div class="radius-account rr-block" data-analytics-private>
              <div class="sync-line">
                <p id="radius-sync-status" role="status">Sign in to save and sync measurements.</p>
                <button id="radius-sync-now" class="sync-now" type="button" hidden>Sync now</button>
                <a id="radius-manage-account" class="sync-link" href="/account/" hidden>Manage account</a>
              </div>
              <button id="radius-review" class="uk-button" type="button" hidden>Review sync changes</button>
            </div>

            <label class="library-search rr-block" data-analytics-private for="library-search" hidden>
              <span class="sr-only">Search saved measurements</span>
              <span class="search-symbol" aria-hidden="true"></span>
              <input id="library-search" type="search" placeholder="Search saved measurements" autocomplete="off" />
            </label>

            <div id="library-empty" class="library-message" hidden>
              <strong>No saved measurements yet</strong>
              <span>Draw a circle, then save it to see it here.</span>
            </div>
            <div id="library-no-results" class="library-message" hidden>No measurements match that search.</div>
            <div id="saved-list" class="saved-list rr-block" data-analytics-private></div>
          </section>
        </div>

        <div id="bestfit-panel" class="tab-panel" role="tabpanel" aria-labelledby="bestfit-tab" hidden>
          <section class="bestfit-section" aria-labelledby="triangulation-heading">
            <h2 id="triangulation-heading" class="uk-step">Best-fit point</h2>
            <p class="uk-hint">Estimates the one point that best matches the edges of three or more visible circles, such as distances to the same place measured from different towns.</p>
            <div id="triangulation-circles" class="bestfit-circles" hidden>
              <p class="uk-label" id="triangulation-circles-label">Circles on the map</p>
              <ol id="triangulation-inputs" class="bestfit-inputs rr-block" data-analytics-private aria-labelledby="triangulation-circles-label"></ol>
            </div>
            <p id="triangulation-hint" class="bestfit-hint">Best fit needs 3 saved circles. Sign in to save them.</p>
            <a id="bestfit-sign-in" class="uk-button" href={signInHref} hidden>Sign in to save circles</a>
            <button
              id="triangulate-button"
              class="uk-button uk-button-primary"
              type="button"
              disabled
              data-umami-event="radius-map-triangulate"
            >Find best-fit point</button>
            <p id="triangulation-status" class="uk-error" role="alert" hidden></p>

            <div id="triangulation-result" class="triangulation-result rr-block" data-analytics-private tabindex="-1" hidden>
              <p class="uk-label">Estimated point</p>
              <p id="result-coordinates" class="result-coordinates"></p>
              <dl class="result-stats">
                <div><dt>Circles used</dt><dd id="result-input-count">0</dd></div>
                <div><dt>Average error</dt><dd id="result-error">—</dd></div>
              </dl>
              <div class="result-actions">
                <button id="copy-result-button" class="uk-button" type="button">Copy coordinates</button>
                <button id="use-result-button" class="uk-button uk-button-primary" type="button">Use as centre</button>
              </div>
            </div>
          </section>
        </div>
      </div>
    </section>

    <div id="map" class="map-canvas rr-block" data-analytics-private role="region" aria-label="Interactive radius map"></div>

    <div class="map-overlay-top">
      <div id="map-hint" class="map-hint" aria-hidden="true">
        <span class="hint-pin" aria-hidden="true"></span>
        <span id="map-hint-text">Tap the map to place your centre</span>
      </div>
      <div id="centre-chip" class="centre-chip rr-block" data-analytics-private hidden>
        <span class="chip-mark" aria-hidden="true"></span>
        <strong id="centre-chip-label">Selected centre</strong>
        <button id="centre-chip-clear" type="button" aria-label="Clear circle">
          <span aria-hidden="true">×</span>
        </button>
      </div>
    </div>
  </div>

  <dialog id="sign-in-dialog" class="action-dialog" aria-labelledby="sign-in-dialog-title">
    <div class="action-dialog-body">
      <p class="uk-step">Save measurement</p>
      <h2 id="sign-in-dialog-title">Saving needs a free account</h2>
      <p id="sign-in-dialog-copy" class="dialog-summary" aria-live="polite">Your circle will be kept while you sign in, and saving opens when you come back.</p>
      <div class="uk-actions dialog-actions">
        <button id="sign-in-dialog-cancel" class="uk-button" type="button">Keep drawing</button>
        <a id="radius-sign-in-to-save" class="uk-button uk-button-primary" href={signInHref} hidden>Sign in to save</a>
      </div>
    </div>
  </dialog>

  <dialog id="radius-review-dialog" class="action-dialog rr-block" data-analytics-private aria-labelledby="radius-review-title">
    <form id="radius-review-form" method="dialog">
      <h2 id="radius-review-title">Review sync changes</h2>
      <div id="radius-review-choices"></div>
      <p id="radius-review-status" class="uk-error" role="alert" hidden></p>
      <div class="uk-actions dialog-actions">
        <button id="radius-review-cancel" class="uk-button" type="button">Cancel</button>
        <button id="radius-review-apply" class="uk-button uk-button-primary" type="submit">Apply choices</button>
      </div>
    </form>
  </dialog>

  <dialog id="save-dialog" class="action-dialog rr-block" data-analytics-private aria-labelledby="save-dialog-title">
    <form id="save-form" method="dialog">
      <h2 id="save-dialog-title">Save measurement</h2>
      <div class="uk-field">
        <label class="uk-label" for="measurement-name">Name</label>
        <input id="measurement-name" class="uk-input" name="name" type="text" maxlength="80" autocomplete="off" required />
      </div>
      <p id="save-dialog-summary" class="dialog-summary"></p>
      <p id="save-dialog-error" class="uk-error" role="alert" hidden></p>
      <div class="uk-actions dialog-actions">
        <button id="save-dialog-cancel" class="uk-button" type="button">Cancel</button>
        <button id="save-dialog-submit" class="uk-button uk-button-primary" type="submit">Save</button>
      </div>
    </form>
  </dialog>

  <dialog id="delete-dialog" class="action-dialog rr-block" data-analytics-private aria-labelledby="delete-dialog-title">
    <form id="delete-form" method="dialog">
      <p class="uk-step danger-step">Delete measurement</p>
      <h2 id="delete-dialog-title">Delete this measurement?</h2>
      <p id="delete-dialog-copy" class="dialog-summary"></p>
      <p id="delete-dialog-error" class="uk-error" role="alert" hidden></p>
      <div class="uk-actions dialog-actions">
        <button id="delete-dialog-cancel" class="uk-button" type="button">Cancel</button>
        <button id="delete-dialog-submit" class="uk-button uk-button-danger" type="submit">Delete</button>
      </div>
    </form>
  </dialog>

  <script>
    import { initializeRadiusMap } from "../../utilities/radius-map/scripts/map-app";
    import { initializePwa } from "../../utilities/radius-map/scripts/pwa";
    initializeRadiusMap();
    initializePwa();
  </script>
</BaseLayout>
