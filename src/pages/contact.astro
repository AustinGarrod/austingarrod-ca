---
import { BriefcaseBusiness, CodeXml, Mail, Send } from "@lucide/astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import { profile } from "@data/profile";
---

<BaseLayout
  active="contact"
  title={`Contact | ${profile.name}`}
  description={`Contact ${profile.name}, ${profile.title} at Epilogue in Ontario, about software development, technical leadership, or a project on this site.`}
  schemaType="ContactPage"
  breadcrumbLabel="Contact Austin Garrod"
>
  <section class="page-hero">
    <div class="container page-hero-inner">
      <p class="eyebrow">Get in touch</p>
      <h1>Start a conversation.</h1>
      <p>
        Get in touch about software development, technical leadership, or a project here. Share a little context and I’ll reply directly. You can use the form or email me.
      </p>
    </div>
  </section>

  <section class="container contact-layout">
    <div id="contact-status" class="contact-status" tabindex="-1">
      <div class="form-status success" data-status="sent" role="status" aria-live="polite" aria-atomic="true" hidden>
        Thanks. Your message was sent, and I’ll reply by email.
        <a class="text-link" href="/contact/">Send another message</a>
      </div>
      <div class="form-status error" data-status="error" role="alert" aria-live="assertive" aria-atomic="true" hidden>
        The message could not be sent. Your text is still below; try again, or email me directly.
      </div>
      <div class="form-status error" data-status="invalid" role="alert" aria-live="assertive" aria-atomic="true" hidden>
        Something in the form needs another look. Check each field and send again.
      </div>
      <div class="form-status error" data-status="limited" role="alert" aria-live="assertive" aria-atomic="true" hidden>
        Too many messages from this connection. Try again in a few minutes, or email me directly.
      </div>
    </div>
    <form class="contact-form rr-block" data-analytics-private action="/contact.php" method="post" aria-describedby="required-note">
      <p id="required-note" class="form-note">All fields are required.</p>

      <div class="field-grid">
        <label>
          <span>Name</span>
          <input name="name" type="text" autocomplete="name" required maxlength="120" />
        </label>
        <label>
          <span>Email</span>
          <input name="email" type="email" autocomplete="email" required maxlength="160" />
        </label>
      </div>
      <label>
        <span>Subject</span>
        <input name="subject" type="text" required maxlength="160" />
      </label>
      <label class="honeypot" aria-hidden="true" tabindex="-1">
        <span>Website</span>
        <input name="website" type="text" autocomplete="off" tabindex="-1" />
      </label>
      <label>
        <span>Message</span>
        <textarea name="message" required minlength="20" maxlength="4000" rows="8" aria-describedby="message-hint"></textarea>
        <small id="message-hint" class="form-note">At least 20 characters.</small>
      </label>
      <button class="button primary" type="submit">
        Send message
        <Send size={18} aria-hidden="true" />
      </button>
    </form>

    <aside class="contact-aside">
      <div>
        <p class="eyebrow">Direct</p>
        <a
          href={`mailto:${profile.email}`}
          data-umami-event="contact-link-click"
          data-umami-event-method="email"
          data-umami-event-placement="contact-page"
        ><Mail size={18} aria-hidden="true" />{profile.email}</a>
      </div>
      <div>
        <p class="eyebrow">Profiles</p>
        <a
          href={profile.github}
          rel="noreferrer"
          target="_blank"
          data-umami-event="outbound-link-click"
          data-umami-event-destination="github"
          data-umami-event-placement="contact-page"
          data-umami-event-url={profile.github}
        ><CodeXml size={18} aria-hidden="true" />GitHub</a>
        <a
          href={profile.linkedin}
          rel="noreferrer"
          target="_blank"
          data-umami-event="outbound-link-click"
          data-umami-event-destination="linkedin"
          data-umami-event-placement="contact-page"
          data-umami-event-url={profile.linkedin}
        ><BriefcaseBusiness size={18} aria-hidden="true" />LinkedIn</a>
      </div>
      <div>
        <p class="eyebrow">Location</p>
        <p>{profile.location}</p>
      </div>
    </aside>
  </section>

  <script>
    const draftKey = "austingarrod.contact.draft";
    const fields = ["name", "email", "subject", "message"] as const;
    const form = document.querySelector<HTMLFormElement>(".contact-form");
    const params = new URLSearchParams(window.location.search);
    const status = params.get("status");
    const allowedStatuses = new Set(["sent", "error", "invalid", "limited"]);

    const readDraft = (): Record<string, string> | null => {
      try {
        const value = window.sessionStorage.getItem(draftKey);
        return value ? JSON.parse(value) : null;
      } catch {
        return null;
      }
    };
    const clearDraft = () => {
      try {
        window.sessionStorage.removeItem(draftKey);
      } catch {
        // The form still works without session storage.
      }
    };

    if (status && allowedStatuses.has(status)) {
      document.querySelector<HTMLElement>(`[data-status="${status}"]`)?.removeAttribute("hidden");
      const banner = document.getElementById("contact-status");

      if (status === "sent") {
        clearDraft();
        if (form) form.hidden = true;
      } else {
        const draft = readDraft();
        for (const name of fields) {
          const field = form?.elements.namedItem(name);
          if (draft?.[name] && (field instanceof HTMLInputElement || field instanceof HTMLTextAreaElement)) field.value = draft[name];
        }
      }

      banner?.scrollIntoView({ block: "start" });
      banner?.focus({ preventScroll: true });

      const trackResult = () => window.umami?.track(`contact-form-${status}`, { form: "contact" });
      if (document.readyState === "complete") {
        trackResult();
      } else {
        window.addEventListener("load", trackResult, { once: true });
      }
    }

    form?.addEventListener("submit", () => {
      try {
        const draft = Object.fromEntries(fields.map((name) => {
          const field = form.elements.namedItem(name);
          return [name, field instanceof HTMLInputElement || field instanceof HTMLTextAreaElement ? field.value : ""];
        }));
        window.sessionStorage.setItem(draftKey, JSON.stringify(draft));
      } catch {
        // Keeping the draft is a convenience; sending does not depend on it.
      }
      window.umami?.track("contact-form-submit", { form: "contact" });
    });
  </script>
</BaseLayout>
