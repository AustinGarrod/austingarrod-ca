---
import { ArrowRight, Download } from "@lucide/astro";
import ContactBand from "@components/ContactBand.astro";
import ProjectCard from "@components/ProjectCard.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import { highlights, profile, projects, skills } from "@data/profile";

const featuredProjectSlugs = ["junkin-electric", "cadence", "idle-slayer-companion"];
const featuredProjects = featuredProjectSlugs
  .map((slug) => projects.find((project) => project.slug === slug))
  .filter((project): project is (typeof projects)[number] => Boolean(project));
const coreTech = ["TypeScript", "React", "Next.js", "Node.js", "MongoDB", "Docker"];
---

<BaseLayout active="home">
  <section class="hero-section">
    <div class="container hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">Full-stack development and technical leadership</p>
        <h1>
          <span>{profile.name}</span>
          {" "}
          <span>{profile.title}</span>
        </h1>
        <p class="hero-summary">{profile.tagline}</p>
        <p class="hero-body">{profile.intro}</p>
        <div class="button-row">
          <a
            class="button primary"
            href="/projects/"
            data-umami-event="cta-click"
            data-umami-event-action="view-projects"
            data-umami-event-placement="home-hero"
          >
            View projects
            <ArrowRight size={18} aria-hidden="true" />
          </a>
          <a
            class="button secondary"
            href={profile.resume}
            download
            data-umami-event="file-download"
            data-umami-event-file="resume"
            data-umami-event-placement="home-hero"
          >
            <Download size={18} aria-hidden="true" />
            Résumé (PDF)
          </a>
        </div>
        <div class="hero-tech" aria-label="Core technologies">
          <span>Core tech</span>
          <div class="tag-list">
            {coreTech.map((item) => <span>{item}</span>)}
          </div>
        </div>
      </div>
      <dl class="hero-facts" aria-label="At a glance">
        {highlights.map((item) => (
          <div>
            <dt>{item.label}</dt>
            <dd>
              <strong>{item.value}</strong>
              <span>{item.description}</span>
            </dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <section class="container content-section selected-work-section">
    <div class="section-heading split">
      <div>
        <p class="eyebrow">Selected work</p>
        <h2>Selected projects and engineering decisions.</h2>
      </div>
      <a
        class="button secondary"
        href="/projects/"
        data-umami-event="cta-click"
        data-umami-event-action="view-projects"
        data-umami-event-placement="selected-work"
      >
        All projects
        <ArrowRight size={18} aria-hidden="true" />
      </a>
    </div>
    <div class="project-grid">
      {featuredProjects.map((project, index) => <ProjectCard project={project} featured={index === 0} />)}
    </div>
  </section>

  <section class="container content-section home-profile-section">
    <div class="section-heading">
      <p class="eyebrow">Engineering profile</p>
      <h2>Technical direction grounded in hands-on development.</h2>
      <p>At Epilogue I build tools for charity partners and internal teams, from interfaces and APIs to access controls, analytics, and scheduled reporting.</p>
    </div>
    <ul class="skills-compact">
      {skills.map((skill) => (
        <li>
          <h3>{skill.title}</h3>
          <div class="tag-list">
            {skill.items.map((item) => <span>{item}</span>)}
          </div>
        </li>
      ))}
    </ul>
    <a class="text-link skills-more" href="/about/#technical-range">
      Full technical range
      <ArrowRight size={16} aria-hidden="true" />
    </a>
  </section>

  <ContactBand placement="home-footer-cta" />
</BaseLayout>
