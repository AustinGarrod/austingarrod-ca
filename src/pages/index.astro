---
import { ArrowRight, Download, MonitorSmartphone, ShieldCheck, SquareTerminal } from "@lucide/astro";
import ProjectCard from "@components/ProjectCard.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import { highlights, profile, projects, skills } from "@data/profile";

const featuredProjectSlugs = ["junkin-electric", "cadence", "spools"];
const featuredProjects = featuredProjectSlugs
  .map((slug) => projects.find((project) => project.slug === slug))
  .filter((project): project is (typeof projects)[number] => Boolean(project));
const coreTech = ["TypeScript", "React", "Next.js", "Node.js", "MongoDB", "Docker"];
---

<BaseLayout active="home">
  <section class="hero-section">
    <div class="container hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">Full-stack development and technical leadership</p>
        <h1>
          <span>{profile.name}</span>
          {" "}
          <span>{profile.title}</span>
        </h1>
        <p class="hero-summary">{profile.tagline}</p>
        <p class="hero-body">{profile.intro}</p>
        <div class="button-row">
          <a
            class="button primary"
            href="/projects/"
            data-umami-event="cta-click"
            data-umami-event-action="view-projects"
            data-umami-event-placement="home-hero"
          >
            View work
            <ArrowRight size={18} aria-hidden="true" />
          </a>
          <a
            class="button secondary"
            href={profile.resume}
            rel="noreferrer"
            target="_blank"
            data-umami-event="resume-view"
            data-umami-event-placement="home-hero"
          >
            View resume
            <Download size={18} aria-hidden="true" />
          </a>
          <a
            class="text-link resume-download-link"
            href={profile.resume}
            download="Austin-Garrod-Resume.pdf"
            data-umami-event="file-download"
            data-umami-event-file="austin-garrod-resume.pdf"
            data-umami-event-placement="home-hero"
          >
            Download PDF
            <Download size={16} aria-hidden="true" />
          </a>
        </div>
        <div class="hero-tech" aria-label="Core technologies">
          <span>Core tech</span>
          <div class="tag-list">
            {coreTech.map((item) => <span>{item}</span>)}
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section-band">
    <div class="container metrics-grid">
      {highlights.map((item) => (
        <article class="metric">
          <strong>{item.value}</strong>
          <span>{item.label}</span>
          <p>{item.description}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="container content-section home-profile-section">
    <div class="section-heading">
      <p class="eyebrow">Engineering profile</p>
      <h2>Technical direction grounded in hands-on development.</h2>
      <p>At Epilogue, I combine full-stack development with architecture and technical direction for charity-partner systems. I work directly with company leadership on tools for partners and internal teams, spanning interfaces, APIs, access controls, analytics, and scheduled AWS reporting.</p>
    </div>
    <div class="skills-grid">
      {skills.map((skill, index) => {
        const icons = [MonitorSmartphone, SquareTerminal, ShieldCheck, ArrowRight];
        const Icon = icons[index] ?? ArrowRight;
        return (
          <article class="skill-panel">
            <Icon size={24} aria-hidden="true" />
            <h3>{skill.title}</h3>
            <p>{skill.summary}</p>
            <div class="tag-list">
              {skill.items.map((item) => <span>{item}</span>)}
            </div>
          </article>
        );
      })}
    </div>
  </section>

  <section class="container content-section selected-work-section">
    <div class="section-heading split">
      <div>
        <p class="eyebrow">Selected work</p>
        <h2>Selected projects and engineering decisions.</h2>
      </div>
      <a
        class="button secondary"
        href="/projects/"
        data-umami-event="cta-click"
        data-umami-event-action="view-projects"
        data-umami-event-placement="selected-work"
      >
        All projects
        <ArrowRight size={18} aria-hidden="true" />
      </a>
    </div>
    <div class="project-grid">
      {featuredProjects.map((project, index) => <ProjectCard project={project} featured={index === 0} />)}
    </div>
  </section>

  <section class="cta-band">
    <div class="container cta-inner">
      <div>
        <p class="eyebrow">Get in touch</p>
        <h2>Let’s talk software.</h2>
        <p>Get in touch about product engineering, technical leadership, or a project you see here.</p>
      </div>
      <a
        class="button primary"
        href="/contact/"
        data-umami-event="cta-click"
        data-umami-event-action="contact"
        data-umami-event-placement="home-footer-cta"
      >
        Start a conversation
        <ArrowRight size={18} aria-hidden="true" />
      </a>
    </div>
  </section>
</BaseLayout>
