---
import { ArrowLeft, ArrowRight, ExternalLink } from "@lucide/astro";
import ContactBand from "@components/ContactBand.astro";
import ProjectVisual from "@components/ProjectVisual.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import { profile, projects, type Project } from "@data/profile";
import { isInternalHref, neighbouringProjects } from "@data/project-order";
import {
  createProjectCreativeWorkSchema,
  getProjectAnchor,
  getProjectDescription,
  getProjectPath,
  getProjectSchemaId
} from "@data/seo";

interface Props {
  project: Project;
}

export function getStaticPaths() {
  return projects.map((project) => ({
    params: {
      slug: project.slug
    },
    props: {
      project
    }
  }));
}

const { project } = Astro.props;
const updatedLabel = new Date(`${project.lastModified}T00:00:00Z`).toLocaleDateString("en-US", {
  month: "short",
  day: "numeric",
  year: "numeric",
  timeZone: "UTC"
});
const projectStructuredData = createProjectCreativeWorkSchema(project);
const { previous, next } = neighbouringProjects(project);
const opensUtility = Boolean(project.href && isInternalHref(project.href));
---

<BaseLayout
  active="projects"
  title={`${project.title} | Project by ${profile.name}`}
  description={getProjectDescription(project)}
  schemaType="WebPage"
  breadcrumbLabel={project.title}
  mainEntityId={getProjectSchemaId(project)}
  structuredData={projectStructuredData}
>
  <section class="page-hero">
    <div class="container page-hero-inner">
      <a class="text-link back-link" href={getProjectAnchor(project)}>
        <ArrowLeft size={16} aria-hidden="true" />
        All projects
      </a>
      <p class="eyebrow">Case study</p>
      <h1>{project.title}</h1>
      <p class="case-study-label">{project.label}</p>
      <p>{project.summary}</p>
      {(project.href || project.source) && (
        <div class="button-row">
          {project.href && opensUtility && (
            <a
              class="button primary"
              href={project.href}
              data-umami-event="utility-open"
              data-umami-event-utility={project.slug}
              data-umami-event-placement="project-detail"
            >
              Open utility
              <ArrowRight size={18} aria-hidden="true" />
            </a>
          )}
          {project.href && !opensUtility && (
            <a
              class="button primary"
              href={project.href}
              rel="noreferrer"
              target="_blank"
              data-umami-event="outbound-link-click"
              data-umami-event-destination="project"
              data-umami-event-project={project.slug}
              data-umami-event-placement="project-detail"
              data-umami-event-url={project.href}
            >
              Visit project
              <ExternalLink size={18} aria-hidden="true" />
            </a>
          )}
          {project.source && (
            <a
              class="button secondary"
              href={project.source}
              rel="noreferrer"
              target="_blank"
              data-umami-event="outbound-link-click"
              data-umami-event-destination="source"
              data-umami-event-project={project.slug}
              data-umami-event-placement="project-detail"
              data-umami-event-url={project.source}
            >
              Source
              <ExternalLink size={18} aria-hidden="true" />
            </a>
          )}
        </div>
      )}
      <dl class="case-study-facts" aria-label={`${project.title} project details`}>
        <div>
          <dt>Status</dt>
          <dd>{project.status}</dd>
        </div>
        <div>
          <dt>My role</dt>
          <dd>{project.role}</dd>
        </div>
        <div>
          <dt>Updated</dt>
          <dd><time datetime={project.lastModified}>{updatedLabel}</time></dd>
        </div>
        <div>
          <dt>Stack</dt>
          <dd>
            <div class="tag-list">
              {project.stack.map((item) => <span>{item}</span>)}
            </div>
          </dd>
        </div>
      </dl>
    </div>
  </section>

  <section class="container content-section project-detail-main">
    <ProjectVisual project={project} />
    <div class="case-study-grid">
      {project.caseStudySections.map((section) => (
        <section class="case-study-section">
          <h2>{section.title}</h2>
          <ul class="project-detail-list">
            {section.points.map((point) => <li>{point}</li>)}
          </ul>
        </section>
      ))}
    </div>
  </section>

  {(previous || next) && (
    <nav class="container project-pager" aria-label="More case studies">
      {previous ? (
        <a
          class="project-pager-link"
          href={getProjectPath(previous)}
          data-umami-event="project-case-study-view"
          data-umami-event-project={previous.slug}
          data-umami-event-placement="case-study-pager"
        >
          <span class="eyebrow"><ArrowLeft size={14} aria-hidden="true" /> Previous project</span>
          <strong>{previous.title}</strong>
          <span>{previous.status}</span>
        </a>
      ) : <span></span>}
      {next && (
        <a
          class="project-pager-link project-pager-next"
          href={getProjectPath(next)}
          data-umami-event="project-case-study-view"
          data-umami-event-project={next.slug}
          data-umami-event-placement="case-study-pager"
        >
          <span class="eyebrow">Next project <ArrowRight size={14} aria-hidden="true" /></span>
          <strong>{next.title}</strong>
          <span>{next.status}</span>
        </a>
      )}
    </nav>
  )}

  <ContactBand placement="case-study-footer-cta" />
</BaseLayout>
