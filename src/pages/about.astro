---
import { Download, ExternalLink } from "@lucide/astro";
import ExperienceTimeline from "@components/ExperienceTimeline.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import { profile, skills } from "@data/profile";
---

<BaseLayout
  active="about"
  title={`About ${profile.name} | ${profile.title}`}
  description={`About ${profile.name}, ${profile.title} at Epilogue in Ontario, with experience in full-stack product engineering, teaching, and applied research.`}
  schemaType="ProfilePage"
  breadcrumbLabel="About Austin Garrod"
>
  <section class="page-hero">
    <div class="container page-hero-inner">
      <p class="eyebrow">Background and experience</p>
      <h1>About Austin Garrod</h1>
      <p>
        I’m a {profile.title.toLowerCase()} at Epilogue, with a background in full-stack product engineering, post-secondary teaching, and applied research. I care about software that teams can understand, maintain, and build on.
      </p>
      <div class="button-row">
        <a
          class="button secondary"
          href={profile.resume}
          rel="noreferrer"
          target="_blank"
          data-umami-event="resume-view"
          data-umami-event-placement="about-hero"
        >
          View resume
          <ExternalLink size={18} aria-hidden="true" />
        </a>
        <a
          class="text-link resume-download-link"
          href={profile.resume}
          download="Austin-Garrod-Resume.pdf"
          data-umami-event="file-download"
          data-umami-event-file="austin-garrod-resume.pdf"
          data-umami-event-placement="about-hero"
        >
          Download PDF
          <Download size={16} aria-hidden="true" />
        </a>
      </div>
    </div>
  </section>

  <section class="container content-section">
    <div class="section-heading">
      <p class="eyebrow">Timeline</p>
      <h2>Professional work, teaching, and applied systems.</h2>
    </div>
    <ExperienceTimeline />
  </section>

  <section class="section-band">
    <div class="container content-section tight">
      <div class="section-heading">
        <p class="eyebrow">Technical range</p>
        <h2>Connecting the system while keeping it maintainable.</h2>
      </div>
      <div class="skills-grid">
        {skills.map((skill) => (
          <article class="skill-panel">
            <h3>{skill.title}</h3>
            <p>{skill.summary}</p>
            <div class="tag-list">
              {skill.items.map((item) => <span>{item}</span>)}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="container content-section two-column">
    <div>
      <p class="eyebrow">Education</p>
      <h2>Durham College</h2>
      <p>Diploma, Computer Programming/Programmer, General, 2016–2017. The program covered programming, databases, networking, web development, testing, and systems development—fundamentals I still use daily.</p>
    </div>
    <div>
      <p class="eyebrow">Teaching foundation</p>
      <h2>Teaching software development</h2>
      <p>Teaching programming and project management at Durham strengthened how I approach debugging, project planning, and technical communication. Explaining software clearly remains central to how I collaborate with developers and company leadership.</p>
    </div>
  </section>
</BaseLayout>
