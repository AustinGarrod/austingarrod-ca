---
import BinderPages from "./BinderPages.astro";
import { BookOpen, ListChecks, Search } from "@lucide/astro";
---
<section class="master-switch dex-toolbar" aria-label="Your binders">
  <label>Open binder <select id="master-switch"><option value="">National Pokédex</option></select></label>
  <button id="master-new">New set binder</button>
</section>
<p id="master-message" role="status" class="dex-help"></p>
<button id="master-conflict" hidden>Keep both versions of conflicting set binders</button>
<section id="master-workspace" hidden aria-labelledby="master-title">
  <div class="dex-section-heading"><h2 id="master-title"></h2></div>
  <section class="dex-progress" aria-label="Collection progress"><div><span class="dex-label">Collected</span><strong id="master-owned"></strong></div><div><span class="dex-label">Still to find</span><strong id="master-missing"></strong></div><div class="dex-completion"><span class="dex-label" id="master-percent"></span><progress id="master-bar" aria-labelledby="master-percent"></progress><span><span id="master-progress"></span> required · Optional extras <span id="master-optional"></span></span></div></section>
  <section class="dex-toolbar" aria-label="Find set cards">
    <label class="dex-search"><Search size={19} aria-hidden="true"/><span class="sr-only">Find a card</span><input type="search" id="master-search" placeholder="Find a card or collector number" /></label>
    <label class="dex-field-inline">Show <select id="master-status"><option value="all">All cards</option><option value="missing">Missing</option><option value="owned">Owned</option></select></label>
    <button id="master-add-extra">Add extra</button>
    <div class="dex-view-toggle" aria-label="View"><button id="master-view-binder" aria-pressed="true"><BookOpen size={16}/> Binder</button><button id="master-view-checklist" aria-pressed="false"><ListChecks size={16}/> Checklist</button></div>
  </section>
  <section id="master-results" class="dex-search-results" aria-label="Search results" hidden></section>
  <BinderPages prefix="master-" />
  <section id="master-checklist" class="dex-checklist" hidden><div class="dex-section-heading"><h2>Your checklist</h2><span id="master-list-count" class="dex-label"></span></div><div id="master-list"></div></section>
</section>
<dialog id="master-editor" class="dex-dialog"><form id="master-form">
  <h2 id="master-editor-title">New set binder</h2>
  <label>English set<input id="master-set" list="master-catalog" required autocomplete="off" placeholder="Search set name or code" /></label><datalist id="master-catalog"></datalist>
  <label>Binder name<input id="master-name" required maxlength="100" /></label>
  <label>Completion goal<select id="master-goal"><option value="variants">Every selected variant</option><option value="numbers">One of each number</option></select></label>
  <label>Pocket order<select id="master-order"><option value="together">Finishes together by number</option><option value="sections">Parallel finishes after the numbered set</option></select></label>
  <details id="master-specialty-section"><summary>Specialty printings to include</summary><div id="master-specialties"></div></details>
  <div class="dex-form-grid"><label>Columns<input id="master-columns" type="number" min="1" max="6" required /></label><label>Rows<input id="master-rows" type="number" min="1" max="6" required /></label></div>
  <label><input id="master-fillers" type="checkbox" /> Add a filler pocket after each single-finish card</label>
  <label id="master-filler-options" hidden>Through collector number (printed set total)
    <input id="master-filler-through" type="number" min="1" max="9007199254740991" step="1" required disabled />
  </label>
  <label>Reserved starting pockets<input id="master-blanks" type="number" min="0" max="1000" required /></label>
  <label><input id="master-backs" type="checkbox" /> Use both sides of each sheet</label>
  <details id="master-extra-options" hidden><summary>Custom extras</summary><div id="master-extra-options-list"></div></details>
  <p id="master-form-error" role="alert"></p><div class="dex-dialog-actions"><button type="button" data-close-dialog>Cancel</button><button class="dex-primary">Save binder</button></div>
</form></dialog>
<dialog id="master-extra-dialog" class="dex-dialog"><form id="master-extra-form"><h2>Add a custom extra</h2>
  <label>Name or printing description<input id="master-extra-name" required maxlength="100" /></label><label>Collector number (optional)<input id="master-extra-number" maxlength="32" /></label>
  <label><input type="checkbox" id="master-extra-required" /> Count toward completion</label><div class="dex-dialog-actions"><button type="button" data-close-dialog>Cancel</button><button>Add extra</button></div>
</form></dialog>
