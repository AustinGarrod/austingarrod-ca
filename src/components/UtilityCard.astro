---
import { ArrowRight, MapPinned } from "@lucide/astro";
import { getUtilityPath } from "@data/seo";
import type { Utility } from "@data/profile";

interface Props {
  utility: Utility;
}

const { utility } = Astro.props;
const href = getUtilityPath(utility);
const icons = { "map-pinned": MapPinned } as const;
const Icon = icons[utility.icon];
---

<article class="utility-card" id={utility.slug}>
  <div class="utility-card-heading">
    <Icon size={28} aria-hidden="true" />
    <span>{utility.status}</span>
  </div>
  <p class="eyebrow">{utility.label}</p>
  <h2><a href={href}>{utility.title}</a></h2>
  <p>{utility.summary}</p>
  <ul>
    {utility.capabilities.map((capability) => <li>{capability}</li>)}
  </ul>
  <div class="tag-list" aria-label={`${utility.title} technologies`}>
    {utility.stack.map((item) => <span>{item}</span>)}
  </div>
  <a
    class="button primary utility-launch"
    href={href}
    data-umami-event="utility-open"
    data-umami-event-utility={utility.slug}
    data-umami-event-placement="utilities-index"
  >
    Open utility
    <ArrowRight size={18} aria-hidden="true" />
  </a>
</article>
