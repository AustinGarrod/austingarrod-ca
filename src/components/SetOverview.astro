---
import { ArrowDownUp, ArrowRight, BookOpen, Layers } from "@lucide/astro";
---
<section id="set-overview" class="binders-home" aria-labelledby="set-overview-title" hidden>
  <header class="set-overview-heading">
    <div>
      <h2 id="set-overview-title" tabindex="-1">Your binders</h2>
      <span id="set-overview-binder-count" class="dex-label"></span>
    </div>
    <div class="dex-actions">
      <button id="home-transfer-open" type="button" aria-haspopup="dialog"><ArrowDownUp size={16} aria-hidden="true" /> Import and export</button>
    </div>
  </header>
  <div id="set-overview-totals" class="set-overview-totals" hidden>
    <dl class="set-overview-counts">
      <div><dt>Collected</dt><dd id="set-overview-owned" data-owned-count></dd></div>
      <div><dt>Ordered</dt><dd id="set-overview-ordered" data-ordered-count></dd></div>
      <div><dt>Still to find</dt><dd id="set-overview-needed" data-needed-count></dd></div>
    </dl>
    <div class="set-overview-completion">
      <span class="dex-label">All binders</span>
      <div class="set-overview-measure">
        <span id="set-overview-percent" data-percent></span>
        <span><span data-required-count></span> required cards</span>
      </div>
      <progress id="set-overview-progress" aria-label="Completion across all binders"></progress>
    </div>
    <div class="set-overview-value" data-market-value>
      <span class="dex-label">Estimated set binder value</span>
      <strong data-value-amount></strong>
      <small data-value-coverage></small>
    </div>
    <div class="set-overview-feedback">
      <p id="set-overview-status" role="status"></p>
      <button id="set-overview-retry" type="button" hidden>Retry loading sets</button>
    </div>
  </div>
  <div id="set-overview-list" class="set-overview-list">
    <section class="set-overview-add" aria-labelledby="set-overview-add-title">
      <h3 id="set-overview-add-title">Add a binder</h3>
      <p>A set binder holds every card in one set. The National Pokédex holds one card per species.</p>
      <div class="set-overview-add-actions">
        <button id="master-new" type="button"><Layers size={16} aria-hidden="true" /> New set binder</button>
        <button id="national-add" type="button" hidden><BookOpen size={16} aria-hidden="true" /> Add National Pokédex</button>
      </div>
    </section>
  </div>
  <template id="set-overview-card">
    <article class="set-overview-card">
      <header>
        <div>
          <p class="set-overview-set"><span data-set-name></span><span data-set-code></span></p>
          <h3></h3>
          <p class="set-overview-goal"></p>
        </div>
        <img class="set-overview-symbol" width="40" height="40" loading="lazy" alt="" hidden />
      </header>
      <div class="set-overview-card-body">
        <dl class="set-overview-counts">
          <div><dt>Collected</dt><dd data-owned-count></dd></div>
          <div><dt>Ordered</dt><dd data-ordered-count></dd></div>
          <div><dt>Still to find</dt><dd data-needed-count></dd></div>
        </dl>
        <div class="set-overview-completion">
          <div class="set-overview-measure">
            <span data-percent></span>
            <span><span data-required-count></span> required cards</span>
          </div>
          <progress></progress>
        </div>
        <p class="set-overview-card-status" hidden></p>
        <div class="set-overview-value" data-market-value>
          <span class="dex-label">Estimated binder value</span>
          <strong data-value-amount></strong>
          <small data-value-coverage></small>
        </div>
      </div>
      <footer><button type="button" data-overview-binder>Open binder <ArrowRight size={16} aria-hidden="true" /></button></footer>
    </article>
  </template>
</section>
