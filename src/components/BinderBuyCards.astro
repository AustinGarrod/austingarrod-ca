---
import { buyingStores, isCrossBorder } from "../utilities/pokedex-binder/lib/buying-offers";
import BinderCatalogSearch from "./BinderCatalogSearch.astro";
import { SlidersHorizontal } from "@lucide/astro";
import "../styles/pokedex-buying.css";
---
<section id="buy-cards-workspace" class="dex-buying-dashboard rr-block" data-analytics-private aria-labelledby="binder-view-title" hidden>
  <header id="buy-cards-heading" class="dex-buying-heading">
    <p>Store prices are in CAD before shipping, taxes, and duties. For cross-border listings, select Canada on the retailer’s site if it opens in another currency. Authenticated store checks send your IP address to Shopify.</p>
  </header>
  <BinderCatalogSearch inline />
  <section id="buy-cards-missing" class="dex-buying-missing" aria-labelledby="buy-cards-missing-title">
    <h2 id="buy-cards-missing-title">Missing from your binders</h2>
    <div id="buy-cards-binder-filters" class="dex-buying-binder-filters" hidden>
      <div class="dex-buying-filter-bar">
        <label class="dex-buying-search">Filter missing cards
          <input id="buy-cards-filter" type="search" placeholder="Name, set, or collector number" autocomplete="off" />
        </label>
        <button id="buy-cards-filters-toggle" type="button" class="dex-buying-filters-toggle" aria-expanded="false" aria-controls="buy-cards-filter-panel"><SlidersHorizontal size={16} aria-hidden="true" /> Filters<span id="buy-cards-filter-count" class="dex-buying-filter-count" hidden></span></button>
      </div>
      <div id="buy-cards-filter-panel" class="dex-buying-filter-panel">
      <div class="dex-buying-filters">
        <label>Set binders <select id="buy-cards-scope"><option value="">All binders</option></select></label>
        <label>Finish <select id="buy-cards-finish"><option value="">All finishes</option></select></label>
        <label>Availability
          <select id="buy-cards-availability">
            <option value="">Any status</option><option value="stock">In stock</option>
            <option value="unchecked">Needs a check</option><option value="none">No matching offer</option>
            <option value="unavailable">Couldn’t check</option>
          </select>
        </label>
        <label>Sort by
          <select id="buy-cards-sort">
            <option value="binder">Binder order</option><option value="name">Card name</option>
            <option value="stock">In stock first</option>
            <option value="market">Market price low to high</option>
            <option value="retail">Store price low to high</option><option value="retail-desc">Store price high to low</option>
          </select>
        </label>
      </div>
      <details id="buy-cards-offer-filters" class="dex-buying-refine">
        <summary>Store, price, and condition <small id="buy-cards-offer-filter-count" hidden></small></summary>
        <div class="dex-buying-filters">
          <label>Store <select id="buy-cards-store">
            <option value="">All stores</option>{buyingStores.map(name => <option value={name}>{name}{isCrossBorder(name) ? " (cross-border)" : ""}</option>)}
          </select></label>
          <label>Maximum price (CAD) <input id="buy-cards-max-price" type="number" min="0" step="0.01" inputmode="decimal" placeholder="Any price" /></label>
          <label>Minimum condition <select id="buy-cards-condition">
            <option value="">Any condition</option><option value="0">Near Mint</option><option value="1">Lightly Played</option>
            <option value="2">Moderately Played</option><option value="3">Heavily Played</option>
          </select></label>
        </div>
      </details>
      <p class="dex-help">Required cards from your set binders, excluding cards already ordered.</p>
      </div>
    </div>
    <div class="dex-buying-summary">
      <p id="buy-cards-status" role="status">Loading your set binders…</p>
      <button id="buy-cards-clear" class="dex-quiet" type="button" hidden>Clear filters</button>
      <div id="buy-cards-binder-actions" class="dex-actions" hidden>
        <button id="buy-cards-check" type="button" disabled>Check this page</button>
        <button id="buy-cards-check-all" class="dex-primary" type="button" disabled>Check all missing cards</button>
        <button id="buy-cards-cancel" class="dex-quiet" type="button" hidden>Stop checking</button>
      </div>
    </div>
    <p id="buy-cards-progress"><span id="buy-cards-countdown" role="timer"></span><span id="buy-cards-check-status" role="status"></span></p>
    <p id="buy-cards-empty" hidden><a href="/utilities/pokemon-binder/" data-binder-view="binders">Go to Binders</a> to set up or connect a set binder.</p>
    <section id="buy-card-pricing" class="dex-buying-detail" aria-labelledby="card-pricing-title" hidden></section>
    <ul id="buy-cards-list" class="dex-buying-list" aria-label="Missing cards and offers"></ul>
    <nav id="buy-cards-pages" class="dex-buying-pages" aria-label="Missing card pages" hidden>
      <button id="buy-cards-prev" type="button">Previous</button>
      <span id="buy-cards-page"></span>
      <button id="buy-cards-next" type="button">Next</button>
    </nav>
  </section>
</section>
