<dialog id="card-import-dialog" class="dex-dialog dex-transfer-dialog rr-block" data-analytics-private aria-labelledby="card-import-title">
  <div class="dex-section-heading"><h2 id="card-import-title">Import cards</h2><button type="button" data-close-dialog aria-label="Close import">×</button></div>
  <p>Open a collection CSV from TCG Collector, Collectr, TCGplayer, or another tracker. Your file is read in this browser.</p>
  <form id="card-import-form">
    <div class="dex-form-grid">
      <label>Import into<select id="card-import-target"><option value="sets">Set binders</option><option value="dex">National Pokédex</option></select></label>
      <label>CSV format<select id="card-import-format"><option value="auto">Detect from file</option><option value="tcgcollector">TCG Collector</option><option value="collectr">Collectr</option><option value="tcgplayer">TCGplayer</option><option value="custom">Map columns</option></select></label>
    </div>
    <label for="card-import-file" class="dex-file-label">Choose CSV file<input id="card-import-file" type="file" accept=".csv,.tsv,text/csv,text/tab-separated-values" required /></label>
    <p id="card-import-filename" class="dex-help dex-transfer-filename" hidden></p>
    <details id="card-import-mapping" hidden><summary>Map CSV columns</summary><div id="card-import-columns" class="dex-transfer-mapping"></div></details>
    <p class="dex-help">Imports track ownership. Extra copies, condition, grades, prices, and notes stay in your original file.</p>
    <button id="card-import-preview" type="submit" class="dex-primary" disabled>Preview import</button>
  </form>
  <section id="card-import-review" aria-labelledby="card-review-title" hidden>
    <h3 id="card-review-title">Review matches</h3>
    <p id="card-review-summary" role="status"></p>
    <div id="card-import-destinations"></div>
    <label class="dex-field-inline">Show rows<select id="card-review-filter"><option value="all">All rows</option><option value="review">Needs review</option><option value="skipped">Skipped</option></select></label>
    <ol id="card-review-rows" class="dex-transfer-rows"></ol>
    <div id="card-review-pager" class="dex-actions" hidden><button id="card-review-prev" type="button">Previous rows</button><span id="card-review-page" role="status"></span><button id="card-review-next" type="button">Next rows</button></div>
    <div class="dex-dialog-actions"><button type="button" data-close-dialog>Cancel</button><button id="card-import-apply" class="dex-primary" type="button">Add cards</button></div>
  </section>
  <p id="card-import-status" role="status" class="dex-help"></p>
  <p id="card-import-error" role="alert" class="dex-error"></p>
</dialog>

<dialog id="card-export-dialog" class="dex-dialog rr-block" data-analytics-private aria-labelledby="card-export-title">
  <div class="dex-section-heading"><h2 id="card-export-title">Export owned cards</h2><button type="button" data-close-dialog aria-label="Close export">×</button></div>
  <form id="card-export-form">
    <label>Set binders<select id="card-export-scope"></select></label>
    <label>CSV format<select id="card-export-format"><option value="portable">Portable CSV</option><option value="binderloot">BinderLoot CSV</option></select></label>
    <p id="card-export-binderloot-help" class="dex-help" hidden>In BinderLoot, choose the TCG Collector importer.</p>
    <p class="dex-help">Each distinct printing and finish counts as one copy. Pokédex checkmarks, unknown finishes, and custom extras are available in your JSON backup.</p>
    <p id="card-export-status" role="status"></p>
    <p id="card-export-error" role="alert" class="dex-error"></p>
    <div class="dex-dialog-actions"><button id="card-export-download" class="dex-primary" type="submit">Download CSV</button></div>
  </form>
</dialog>
