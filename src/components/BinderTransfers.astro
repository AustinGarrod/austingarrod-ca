---
import { tcgplayerConditions } from "../utilities/pokedex-binder/lib/card-transfer";
---

<dialog id="card-import-dialog" class="dex-dialog dex-collection-dialog dex-transfer-dialog rr-block" data-analytics-private aria-labelledby="card-import-title">
  <header class="dex-dialog-header"><h2 id="card-import-title">Import cards</h2><button type="button" data-close-dialog aria-label="Close import">×</button></header>
  <p id="card-import-intro" class="dex-dialog-intro">Open a collection CSV from TCG Collector, Collectr, TCGplayer, or another tracker. Your file is read in this browser.</p>
  <p id="card-import-collectr-help" class="dex-dialog-intro" hidden>Export your collection as a CSV in the Collectr app, then choose that file here. Your file is read in this browser. <a href="https://www.getcollectr.com/pro" target="_blank" rel="noopener noreferrer">About Collectr export (Pro)</a></p>
  <form id="card-import-form" class="dex-dialog-form">
    <div class="dex-form-grid">
      <label>Import into<select id="card-import-target"><option value="sets">Set binders</option><option value="dex">National Pokédex</option></select></label>
      <label>CSV format<select id="card-import-format"><option value="auto">Detect from file</option><option value="tcgcollector">TCG Collector</option><option value="collectr">Collectr</option><option value="tcgplayer">TCGplayer</option><option value="custom">Map columns</option></select></label>
    </div>
    <div class="dex-transfer-file">
      <label for="card-import-file" class="dex-file-label">Choose CSV file<input id="card-import-file" type="file" accept=".csv,.tsv,text/csv,text/tab-separated-values" required /></label>
      <p id="card-import-filename" class="dex-help dex-transfer-filename" hidden></p>
    </div>
    <details id="card-import-mapping" hidden><summary>Map CSV columns</summary><div id="card-import-columns" class="dex-transfer-mapping"></div></details>
    <fieldset id="card-import-portfolios" hidden>
      <legend>Collectr portfolios</legend>
      <div id="card-import-portfolio-options"></div>
      <p id="card-import-portfolio-count" role="status"></p>
    </fieldset>
    <p class="dex-help">Imports track ownership. Extra copies, condition, grades, prices, and notes stay in your original file.</p>
    <div><button id="card-import-preview" type="submit" class="dex-primary" disabled>Preview import</button></div>
  </form>
  <section id="card-import-review" aria-labelledby="card-review-title" hidden>
    <h3 id="card-review-title" tabindex="-1">Review matches</h3>
    <p id="card-review-summary" role="status"></p>
    <div id="card-import-destinations"></div>
    <label class="dex-field-inline">Show rows<select id="card-review-filter"><option value="all">All rows</option><option value="review">Needs review</option><option value="skipped">Skipped</option></select></label>
    <ol id="card-review-rows" class="dex-transfer-rows"></ol>
    <div id="card-review-pager" class="dex-actions" hidden><button id="card-review-prev" type="button">Previous rows</button><span id="card-review-page" role="status"></span><button id="card-review-next" type="button">Next rows</button></div>
    <div class="dex-dialog-actions">
      <p id="card-import-save-status" role="status"></p>
      <p id="card-import-save-error" class="dex-error" role="alert"></p>
      <button type="button" data-close-dialog>Cancel</button>
      <button id="card-import-apply" class="dex-primary" type="button">Add cards</button>
    </div>
  </section>
  <p id="card-import-status" role="status" class="dex-help"></p>
  <p id="card-import-error" role="alert" class="dex-error"></p>
</dialog>

<dialog id="card-export-dialog" class="dex-dialog dex-collection-dialog rr-block" data-analytics-private aria-labelledby="card-export-title">
  <header class="dex-dialog-header"><h2 id="card-export-title">Export cards</h2><button type="button" data-close-dialog aria-label="Close export">×</button></header>
  <form id="card-export-form" class="dex-dialog-form">
    <label>Cards to export<select id="card-export-list"><option value="owned">Owned cards</option><option value="missing">Missing cards</option><option value="ordered">Ordered cards</option></select></label>
    <label>Set binders<select id="card-export-scope"></select></label>
    <label>CSV format<select id="card-export-format"><option value="portable">Portable CSV</option><option value="binderloot">BinderLoot CSV</option><option value="tcgplayer">TCGplayer mobile CSV</option></select></label>
    <p id="card-export-binderloot-help" class="dex-help" hidden>In BinderLoot, choose the TCG Collector importer.</p>
    <div id="card-export-tcgplayer-options" class="dex-dialog-note" hidden>
      <p class="dex-help">In TCGplayer, open Collection and choose Import a list via file.</p>
      <label>Condition for exported cards<select id="card-export-tcgplayer-condition" disabled><option value="">Choose a condition</option>{tcgplayerConditions.map(condition => <option>{condition}</option>)}</select>
        <small>This condition applies to every row. For mixed conditions, edit the Condition column before importing.</small>
      </label>
    </div>
    <p id="card-export-owned-help" class="dex-help">Each distinct printing and finish counts as one copy. Pokédex checkmarks, unknown finishes, and custom extras are available in your JSON backup.</p>
    <p id="card-export-missing-help" class="dex-help" hidden>Missing cards are the checklist entries you still need to find.</p>
    <p id="card-export-pending-help" class="dex-help" hidden>Portable CSV can list cards with any finish. BinderLoot and TCGplayer require an exact printing.</p>
    <p id="card-export-status" role="status"></p>
    <p id="card-export-error" role="alert" class="dex-error"></p>
    <div class="dex-dialog-actions"><button id="card-export-download" class="dex-primary" type="submit">Download CSV</button></div>
  </form>
</dialog>
