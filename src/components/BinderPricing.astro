---
import { ExternalLink, ShoppingBag } from "@lucide/astro";
import { buyingStores } from "../utilities/pokedex-binder/lib/buying-offers";
import "../styles/pokedex-buying.css";
---
<dialog id="card-pricing-dialog" class="dex-dialog dex-collection-dialog dex-pricing-dialog rr-block" data-analytics-private aria-labelledby="card-pricing-title">
  <header class="dex-dialog-header">
    <h2 id="card-pricing-title">Card prices</h2>
    <button type="button" data-close-dialog aria-label="Close card prices">×</button>
  </header>
  <div class="dex-price-card">
    <img id="card-pricing-image" width="88" height="123" alt="" hidden />
    <div>
      <p id="card-pricing-identity" class="dex-label"></p>
      <p id="card-pricing-finish"></p>
      <label id="card-pricing-variants" hidden>Printing
        <select id="card-pricing-variant"></select>
      </label>
    </div>
  </div>
  <p id="card-pricing-status" role="status"></p>
  <div id="card-pricing-exact" hidden>
    <section class="dex-pricing-section" aria-labelledby="card-market-heading">
      <div class="dex-section-heading">
        <h3 id="card-market-heading">Market estimate</h3>
        <a href="https://www.cardmarket.com/en/Pokemon/Products" target="_blank" rel="noopener noreferrer"
          data-umami-event="outbound-link-click" data-umami-event-destination="cardmarket" aria-label="Cardmarket (opens in new tab)">
          Cardmarket <ExternalLink size={13} aria-hidden="true" />
        </a>
      </div>
      <p id="card-market-current" class="dex-market-value" role="status"></p>
      <p id="card-market-date" class="dex-help"></p>
      <label for="card-market-range">Price history
        <select id="card-market-range"><option value="30">Last 30 days</option><option value="90">Last 90 days</option></select>
      </label>
      <p id="card-market-history-status" role="status"></p>
      <div id="card-market-chart-region" class="dex-market-chart" hidden>
        <canvas id="card-market-chart" role="img" aria-label="Cardmarket price history in Canadian dollars"></canvas>
        <label for="card-market-point">Explore recorded prices
          <input id="card-market-point" type="range" min="0" max="1" value="0" />
        </label>
        <output id="card-market-point-value" for="card-market-point" aria-live="polite"></output>
      </div>
    </section>
    <section class="dex-pricing-section" aria-labelledby="card-retail-heading">
      <div class="dex-section-heading">
        <h3 id="card-retail-heading"><ShoppingBag size={17} aria-hidden="true" /> Canadian stores</h3>
        <button id="card-retail-refresh" type="button">Refresh offers</button>
      </div>
      <p class="dex-help">Online availability · Prices before shipping and tax</p>
      <p id="card-retail-status" role="status"></p>
      <ul id="card-retail-offers" class="dex-retail-offers"></ul>
    </section>
  </div>
  <div class="dex-dialog-actions">
    <button id="card-pricing-back" type="button" hidden>Back to Buy Cards</button>
    <button type="button" class="dex-primary" data-close-dialog>Done</button>
  </div>
</dialog>

<dialog id="buy-cards-dialog" class="dex-dialog dex-collection-dialog dex-buying-dashboard rr-block" data-analytics-private aria-labelledby="buy-cards-title">
  <header class="dex-dialog-header">
    <h2 id="buy-cards-title">Buy Cards</h2>
    <button type="button" data-close-dialog aria-label="Close Buy Cards">×</button>
  </header>
  <div class="dex-buying-filters">
    <label class="dex-buying-search">Find a missing card
      <input id="buy-cards-filter" type="search" placeholder="Name, set, or collector number" autocomplete="off" />
    </label>
    <label>Set binders <select id="buy-cards-scope"><option value="">All binders</option></select></label>
    <label>Finish <select id="buy-cards-finish"><option value="">All finishes</option></select></label>
    <label>Availability
      <select id="buy-cards-availability">
        <option value="">Any status</option><option value="stock">In stock</option>
        <option value="unchecked">Unchecked</option><option value="none">No offers</option>
        <option value="unavailable">Unavailable</option>
      </select>
    </label>
    <label>Sort by
      <select id="buy-cards-sort">
        <option value="binder">Binder order</option><option value="name">Card name</option>
        <option value="market">Market price ↑</option><option value="retail">Store price ↑</option>
      </select>
    </label>
  </div>
  <details id="buy-cards-offer-filters" class="dex-buying-refine">
    <summary>Store, price, and condition</summary>
    <div class="dex-buying-filters">
      <label>Store <select id="buy-cards-store">
        <option value="">All stores</option>{buyingStores.map(name => <option>{name}</option>)}
      </select></label>
      <label>Maximum price (CAD) <input id="buy-cards-max-price" type="number" min="0" step="0.01" inputmode="decimal" placeholder="Any price" /></label>
      <label>Minimum condition <select id="buy-cards-condition">
        <option value="">Any condition</option><option value="0">Near Mint</option><option value="1">Lightly Played</option>
        <option value="2">Moderately Played</option><option value="3">Heavily Played</option>
      </select></label>
    </div>
  </details>
  <p class="dex-help">Required cards from your set binders, excluding cards already ordered. Store prices are in CAD before shipping and tax.</p>
  <div class="dex-buying-summary">
    <p id="buy-cards-status" role="status"></p>
    <div class="dex-actions">
      <button id="buy-cards-clear" class="dex-quiet" type="button" hidden>Clear filters</button>
      <button id="buy-cards-check" class="dex-primary" type="button" disabled>Check this page</button>
    </div>
  </div>
  <p id="buy-cards-progress" role="status"></p>
  <ul id="buy-cards-list" class="dex-buying-list" aria-label="Missing cards and offers"></ul>
  <nav id="buy-cards-pages" class="dex-buying-pages" aria-label="Missing card pages" hidden>
    <button id="buy-cards-prev" type="button">Previous</button>
    <span id="buy-cards-page"></span>
    <button id="buy-cards-next" type="button">Next</button>
  </nav>
</dialog>
