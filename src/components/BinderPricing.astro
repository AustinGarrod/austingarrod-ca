---
import { ExternalLink, ShoppingBag } from "@lucide/astro";
import { binderSettingsPath } from "../../packages/accounts/client";
---
<dialog id="card-pricing-dialog" class="dex-dialog dex-collection-dialog dex-pricing-dialog rr-block" data-analytics-private aria-labelledby="card-pricing-title">
  <div id="card-pricing-content" class="dex-price-content">
    <header class="dex-price-header dex-dialog-header">
      <h2 id="card-pricing-title" tabindex="-1">Card prices</h2>
      <button id="card-pricing-close" type="button" data-close-dialog aria-label="Close card prices">×</button>
      <button id="card-pricing-back" type="button" hidden>Back to results</button>
    </header>
    <div class="dex-price-card">
      <img id="card-pricing-image" width="88" height="123" alt="" hidden />
      <div>
        <p id="card-pricing-identity" class="dex-label"></p>
        <p id="card-pricing-finish"></p>
        <label id="card-pricing-variants" hidden>Printing
          <select id="card-pricing-variant"></select>
        </label>
      </div>
    </div>
    <p id="card-pricing-status" role="status"></p>
    <div id="card-pricing-exact" hidden>
      <section class="dex-pricing-section" aria-labelledby="card-market-heading">
        <h3 id="card-market-heading">Market estimate</h3>
        <p id="card-market-current" class="dex-market-value" role="status"></p>
        <p id="card-market-source" class="dex-help dex-market-source" hidden>
          <span><a href="https://help.tcgplayer.com/hc/en-us/articles/213588017-TCGplayer-Market-Price" target="_blank" rel="noopener noreferrer"
            data-umami-event="outbound-link-click" data-umami-event-destination="tcgplayer" aria-label="About TCGplayer sales data (opens in new tab)">
            TCGplayer sales <ExternalLink size={13} aria-hidden="true" />
          </a> · USD to CAD</span>
          <span class="dex-price-date">Updated <time id="card-market-date"></time></span>
        </p>
        <details id="card-market-history" class="dex-market-history">
          <summary>Price history</summary>
          <label for="card-market-range">Date range
            <select id="card-market-range"><option value="30">Last 30 days</option><option value="90">Last 90 days</option></select>
          </label>
          <p id="card-market-history-status" role="status"></p>
          <div id="card-market-chart-region" class="dex-market-chart" hidden>
            <canvas id="card-market-chart" role="img" aria-label="TCGplayer market price history in Canadian dollars"></canvas>
            <label for="card-market-point">Explore recorded prices
              <input id="card-market-point" type="range" min="0" max="1" value="0" />
            </label>
            <output id="card-market-point-value" for="card-market-point" aria-live="polite"></output>
          </div>
        </details>
      </section>
      <section class="dex-pricing-section" aria-labelledby="card-retail-heading">
        <div class="dex-section-heading">
          <h3 id="card-retail-heading"><ShoppingBag size={17} aria-hidden="true" /> Store offers</h3>
          <button id="card-retail-refresh" type="button">Refresh offers</button>
        </div>
        <p class="dex-help">Prices are in CAD before shipping, taxes, and duties. For cross-border listings, select Canada on the retailer’s site if it opens in another currency. Authenticated store checks send your IP address to Shopify.</p>
        <p id="card-retail-status" role="status"></p>
        <p class="dex-help" id="card-retail-settings" hidden><a href={binderSettingsPath} data-binder-view="settings">Retailer settings</a></p>
        <ul id="card-retail-offers" class="dex-retail-offers"></ul>
      </section>
    </div>
    <div id="card-pricing-actions" class="dex-dialog-actions">
      <button type="button" class="dex-primary" data-close-dialog>Done</button>
    </div>
  </div>
</dialog>
