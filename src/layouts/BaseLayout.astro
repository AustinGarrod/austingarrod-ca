---
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import "@styles/global.css";
import { profile } from "@data/profile";
import { createBaseJsonLdGraph, type JsonLd, type SchemaPageType } from "@data/seo";

interface Props {
  title?: string;
  description?: string;
  active?: "home" | "about" | "projects" | "utilities" | "contact";
  noIndex?: boolean;
  schemaType?: SchemaPageType;
  breadcrumbLabel?: string;
  mainEntityId?: string;
  structuredData?: JsonLd | JsonLd[];
  shell?: "site" | "utility";
  manifestPath?: string;
  themeColor?: string;
  ogImagePath?: string;
  ogImageAlt?: string;
  ogImageWidth?: number;
  ogImageHeight?: number;
  bodyClass?: string;
}

const defaultSchemaType: SchemaPageType = Astro.url.pathname === "/" ? "ProfilePage" : "WebPage";
const {
  title = `${profile.name} | ${profile.title}`,
  description = profile.seoDescription,
  active,
  noIndex = false,
  schemaType = defaultSchemaType,
  breadcrumbLabel,
  mainEntityId,
  structuredData,
  shell = "site",
  manifestPath = "/site.webmanifest",
  themeColor = "#f8f9ff",
  ogImagePath = "/og-image.png",
  ogImageAlt = `${profile.name} - ${profile.title}`,
  ogImageWidth = 1200,
  ogImageHeight = 630,
  bodyClass
} = Astro.props;

const canonical = new URL(Astro.url.pathname, "https://austingarrod.ca").toString();
const ogImage = new URL(ogImagePath, "https://austingarrod.ca").toString();
const structuredDataItems = structuredData ? (Array.isArray(structuredData) ? structuredData : [structuredData]) : [];
const jsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    ...createBaseJsonLdGraph({
      canonical,
      pathname: Astro.url.pathname,
      title,
      description,
      schemaType,
      breadcrumbLabel,
      mainEntityId
    }),
    ...structuredDataItems
  ]
}).replace(/</g, "\\u003c");
const analyticsEnabled = import.meta.env.PROD;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noIndex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="manifest" href={manifestPath} />
    <meta name="theme-color" content={themeColor} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:image:width" content={String(ogImageWidth)} />
    <meta property="og:image:height" content={String(ogImageHeight)} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:site_name" content={profile.name} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
    <script type="application/ld+json" set:html={jsonLd} is:inline></script>
    <slot name="head" />
    {analyticsEnabled && (
      <>
      <script is:inline>
        // Umami's embedded heatmap preview must not count as a visitor.
        window.umamiBeforeSend = (_type, payload) => window.self === window.top ? payload : false;
      </script>
      <script
        id="umami-tracker"
        defer
        src="https://analytics.garrod.house/script.js"
        data-website-id="bad8bf39-f9e4-4e54-865c-f3438804a9b5"
        data-domains="austingarrod.ca,www.austingarrod.ca"
        data-performance="true"
        data-do-not-track="true"
        data-exclude-hash="true"
        data-before-send="umamiBeforeSend"
        is:inline
      ></script>
      <script is:inline>
        // recorder.js does not implement the tracker's domain or opt-out attributes.
        document.getElementById("umami-tracker").addEventListener("load", () => {
          const dnt = window.doNotTrack || navigator.doNotTrack || navigator.msDoNotTrack;
          if (window.self !== window.top
            || !["austingarrod.ca", "www.austingarrod.ca"].includes(window.location.hostname)
            || dnt === 1 || dnt === "1" || dnt === "yes") return;
          try {
            if (window.localStorage.getItem("umami.disabled")) return;
          } catch {
            // Analytics can still work when browser storage is unavailable.
          }
          const recorder = document.createElement("script");
          recorder.src = "https://analytics.garrod.house/recorder.js";
          recorder.async = true;
          recorder.dataset.websiteId = "bad8bf39-f9e4-4e54-865c-f3438804a9b5";
          document.head.appendChild(recorder);
        }, { once: true });
      </script>
      </>
    )}
  </head>
  <body class={bodyClass}>
    <a class="skip-link" href="#main">Skip to content</a>
    {shell === "site" && <Header active={active} />}
    <main id="main">
      <slot />
    </main>
    {shell === "site" && <Footer />}
  </body>
</html>
