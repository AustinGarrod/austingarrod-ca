<Files "market.php">
  SetHandler application/x-httpd-alt-php84___lsphp
</Files>
<Files "offers.php">
  SetHandler application/x-httpd-alt-php84___lsphp
</Files>
<FilesMatch "^_.*\.php$">
  Require all denied
</FilesMatch>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "no-referrer"
</IfModule>
