ErrorDocument 404 /404.html

<Files "contact.php">
  SetHandler application/x-httpd-alt-php84___lsphp
</Files>

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Keep old binder page links working alongside existing catalog and API URLs.
  RewriteRule ^utilities/pokedex-binder(?:/index\.html|/)?$ https://austingarrod.ca/utilities/pokemon-binder/ [R=301,L,NE]

  # Collapse explicit index.html URLs directly to the canonical HTTPS route.
  # Companion precache verifies physical HTML entries without following redirects.
  RewriteCond %{REQUEST_URI} !^/utilities/idle-slayer-companion/ [NC]
  RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.html(?:[?\s]) [NC]
  RewriteRule ^(.*/)?index\.html$ https://austingarrod.ca/$1 [R=301,L,NE]

  # Serve one origin so contact submissions and canonical signals always use HTTPS.
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} !^austingarrod\.ca$ [NC]
  RewriteRule ^ https://austingarrod.ca%{REQUEST_URI} [R=301,L,NE]

  # Older open binder tabs lazy-load a scanner module removed by a later release.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^_astro/scanner\.[A-Za-z0-9_-]+\.js$ utilities/pokedex-binder/scanner-update.js [L]

  # Dispatch only the public MCP routes to the scoped account PHP handler.
  RewriteRule ^api/v1/_(?:mcp-vendor|mcp-data)(?:/|$) - [F,L,NC]
  RewriteRule ^api/v1/mcp/ - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
  RewriteRule ^api/v1/mcp/(?:pokedex-binder|idle-slayer-companion|connections|oauth/(?:authorize|token|consent))$ api/v1/mcp.php [L]
  RewriteRule ^\.well-known/(?:oauth-authorization-server|oauth-protected-resource/api/v1/mcp/(?:pokedex-binder|idle-slayer-companion))$ api/v1/mcp.php [L]
</IfModule>

<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
  AddType application/json .json
</IfModule>

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  # Only this site and its private Umami dashboard may embed heatmap previews.
  Header unset X-Frame-Options
  Header set Permissions-Policy "camera=(), geolocation=(), microphone=(), payment=(), usb=()"
  Header set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://analytics.garrod.house; connect-src 'self' https://analytics.garrod.house https://reports.garrod.house; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'self' https://analytics.garrod.house; form-action 'self'"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" "expr=%{HTTPS} == 'on'"

  <Files "austin-garrod-resume.pdf">
    Header set Cache-Control "public, max-age=3600, must-revalidate"
  </Files>

  <Files "deployment-manifest.json">
    Header set Cache-Control "no-store"
  </Files>

  <Files "utility-release.json">
    Header set Cache-Control "no-store"
  </Files>

  <FilesMatch "^_astro/.*\.(css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType application/pdf "access plus 1 hour"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>
